---
import EquipoPublico from "@components/equipos/publico/EquipoPublico";
import Layout from "@layouts/Layout.astro";

import {
  ErrorObtenerEquipoPublico,
  obtenerEquipoPublico,
} from "@servicios/backend/equipos/obtenerEquipoPublico";

import type { DatosEquipoPublico } from "@tipos/EquipoPublico";

export const prerender = false;

const equipoSlug =
  Astro.params.slug?.trim() ?? "";

let equipo:
  DatosEquipoPublico | null = null;

let estado:
  | "correcto"
  | "no-encontrado"
  | "error" = "correcto";

let mensajeError: string | null =
  null;

try {
  equipo =
    await obtenerEquipoPublico(
      equipoSlug,
    );
} catch (error) {
  if (
    error instanceof
      ErrorObtenerEquipoPublico &&
    error.status === 404
  ) {
    estado = "no-encontrado";
    Astro.response.status = 404;
  } else {
    console.error(
      `Error cargando la página pública del equipo ${equipoSlug}:`,
      error,
    );

    estado = "error";

    mensajeError =
      error instanceof Error
        ? error.message
        : "No se ha podido cargar la información del equipo.";

    Astro.response.status =
      error instanceof
      ErrorObtenerEquipoPublico
        ? error.status
        : 500;
  }
}

/*
 * Esta propiedad mantiene la compatibilidad
 * temporal con EquipoPublico.tsx mientras
 * sustituimos sus bloques provisionales.
 *
 * El objeto también conserva todos los datos
 * nuevos: fbib, entrenamientos y patrocinadores.
 */
const equipoParaComponente =
  equipo
    ? {
        ...equipo,

        idEquipoFbib:
          equipo.fbib?.idEquipoFbib ??
          null,
      }
    : null;
---

<Layout
  title={equipo?.nombreCorto?.trim() || equipo?.nombre || (estado === "error" ? "Error al cargar el equipo" : "Equipo no encontrado")}
  menu
  menuMobile
>
  {
    estado === "error" ? (
      <main class="mx-auto flex min-h-[65dvh] w-full max-w-xl items-center px-4 py-10">
        <section class="w-full rounded-2xl border border-error/40 bg-error-container p-7 text-center text-on-error-container shadow-sm">
          <span
            class="mx-auto inline-block h-12 w-12 bg-error mask-center mask-contain mask-no-repeat"
            style="mask-image: url('/iconos/panel/error.svg'); -webkit-mask-image: url('/iconos/panel/error.svg');"
            aria-hidden="true"
          />

          <p class="mt-4 text-sm font-black uppercase tracking-[0.18em]">
            Error
          </p>

          <h1 class="mt-1 text-2xl font-black">
            No se ha podido cargar el equipo
          </h1>

          <p class="mt-2 text-sm">
            {
              mensajeError ??
              "Ha ocurrido un problema al consultar la información del equipo."
            }
          </p>

          <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="/equipos"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-error px-5 py-3 text-sm font-bold text-on-error"
            >
              <span
                class="inline-block h-4 w-4 bg-current mask-center mask-contain mask-no-repeat"
                style="mask-image: url('/iconos/panel/volver.svg'); -webkit-mask-image: url('/iconos/panel/volver.svg');"
                aria-hidden="true"
              />

              Volver a todos los equipos
            </a>

            <a
              href={`/equipos/${encodeURIComponent(equipoSlug)}`}
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-error px-5 py-3 text-sm font-bold transition-colors hover:bg-error hover:text-on-error"
            >
              Volver a intentarlo
            </a>
          </div>
        </section>
      </main>
    ) : estado === "no-encontrado" ||
      !equipoParaComponente ? (
      <main class="mx-auto flex min-h-[65dvh] w-full max-w-xl items-center px-4 py-10">
        <section class="w-full rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-7 text-center shadow-sm">
          <span
            class="mx-auto inline-block h-14 w-14 bg-outline mask-center mask-contain mask-no-repeat"
            style="mask-image: url('/iconos/panel/equipos.svg'); -webkit-mask-image: url('/iconos/panel/equipos.svg');"
            aria-hidden="true"
          />

          <p class="mt-4 text-sm font-black uppercase tracking-[0.18em] text-primary">
            Error 404
          </p>

          <h1 class="mt-1 text-2xl font-black text-on-surface">
            Equipo no encontrado
          </h1>

          <p class="mt-2 text-sm leading-6 text-on-surface-variant">
            El equipo solicitado no existe o no está disponible públicamente.
          </p>

          <a
            href="/equipos"
            class="mt-6 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-on-primary transition-colors hover:bg-on-primary-container"
          >
            <span
              class="inline-block h-4 w-4 bg-current mask-center mask-contain mask-no-repeat"
              style="mask-image: url('/iconos/panel/volver.svg'); -webkit-mask-image: url('/iconos/panel/volver.svg');"
              aria-hidden="true"
            />

            Volver a todos los equipos
          </a>
        </section>
      </main>
    ) : (
      <EquipoPublico
        client:load
        equipoInicial={equipoParaComponente}
        patrocinadoresIniciales={equipoParaComponente.patrocinadores}
      />
    )
  }
</Layout>