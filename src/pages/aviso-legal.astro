---
import Layout from "@layouts/Layout.astro";

const ultimaActualizacion = "20 de agosto de 2026";

/*
 * IMPORTANTE:
 * La directiva debe confirmar estos datos antes de publicar la página.
 *
 * Aunque el club no sea una empresa, puede disponer de:
 * - NIF de la entidad.
 * - Domicilio establecido en sus estatutos.
 * - Número de inscripción en un registro deportivo o de asociaciones.
 */
const datosTitular = {
  nombre: "C.B. Andratx",
  denominacionOficial: "Club Baloncesto Andratx",
  nif: "",
  domicilio: "",
  registro: "",
  email: "",
  telefono: "",
  web: "https://cb-andratx-chatbot.vercel.app",
};

const datosPendientes = [
  !datosTitular.nif && "NIF de la entidad",
  !datosTitular.domicilio && "Domicilio estatutario",
  !datosTitular.registro && "Datos de inscripción registral",
  !datosTitular.email && "Correo electrónico de contacto",
].filter(Boolean);
---

<Layout title="Aviso legal" description="Aviso legal y condiciones de utilización del sitio web del C.B. Andratx." menu menuMobile>
  <!-- <div class="mx-auto w-full max-w-240 px-4 py-8 pb-28 sm:px-6 md:py-12 md:pb-16">
    <header class="relative overflow-hidden rounded-2xl border border-primary/25 bg-primary-container/20 p-6 sm:p-8">
      <span class="pointer-events-none absolute -right-12 -top-12 text-primary/10" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="h-44 w-44" fill="currentColor">
          <path d="M320-240h320v-80H320zm0-160h320v-80H320zm-80 320q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h320l240 240v480q0 33-23.5 56.5T720-80zm280-520v-200H240v640h480v-440zM240-800v200-200 640-640z"></path>
        </svg>
      </span>

      <div class="relative max-w-180">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">Información legal</p>
        <h1 class="mt-2 text-3xl font-bold text-on-secondary-fixed sm:text-4xl">Aviso legal</h1>
        <p class="mt-3 leading-relaxed text-on-surface-variant">Información sobre la titularidad, las condiciones de acceso y la utilización del sitio web del C.B. Andratx.</p>
        <p class="mt-4 text-sm font-semibold text-primary">Última actualización: {ultimaActualizacion}</p>
      </div>
    </header>

    {datosPendientes.length > 0 && (
      <aside class="mt-6 rounded-2xl border border-tertiary/35 bg-tertiary-fixed p-5 text-on-tertiary-fixed" role="note">
        <p class="font-bold">Información pendiente de confirmar</p>
        <p class="mt-2 text-sm leading-relaxed">Antes de publicar definitivamente este aviso legal, la directiva debe facilitar los siguientes datos:</p>

        <ul class="mt-3 list-inside list-disc space-y-1 text-sm">
          {datosPendientes.map((dato) => <li>{dato}</li>)}
        </ul>
      </aside>
    )}

    <div class="mt-8 flex flex-col gap-6">
      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="titularidad">
        <h2 id="titularidad" class="text-xl font-bold text-on-secondary-fixed">1. Titularidad del sitio web</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Este sitio web es gestionado por el C.B. Andratx con la finalidad de ofrecer información relacionada con el club, sus equipos, actividades y competiciones.</p>

        <dl class="mt-5 grid gap-4 rounded-xl bg-surface-container p-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">Titular</dt>
            <dd class="mt-1 text-sm text-on-surface">{datosTitular.nombre}</dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">Denominación</dt>
            <dd class="mt-1 text-sm text-on-surface">{datosTitular.denominacionOficial}</dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">NIF</dt>
            <dd class="mt-1 text-sm text-on-surface">{datosTitular.nif || "Pendiente de confirmación"}</dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">Domicilio</dt>
            <dd class="mt-1 text-sm text-on-surface">{datosTitular.domicilio || "Pendiente de confirmación"}</dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">Registro</dt>
            <dd class="mt-1 text-sm text-on-surface">{datosTitular.registro || "Pendiente de confirmación"}</dd>
          </div>

          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">Correo electrónico</dt>
            <dd class="mt-1 text-sm text-on-surface">
              {datosTitular.email ? <a href={`mailto:${datosTitular.email}`} class="font-semibold text-primary hover:underline">{datosTitular.email}</a> : "Pendiente de confirmación"}
            </dd>
          </div>

          {datosTitular.telefono && (
            <div>
              <dt class="text-xs font-bold uppercase tracking-wide text-primary">Teléfono</dt>
              <dd class="mt-1 text-sm text-on-surface">
                <a href={`tel:${datosTitular.telefono.replace(/\s/g, "")}`} class="font-semibold text-primary hover:underline">{datosTitular.telefono}</a>
              </dd>
            </div>
          )}

          <div>
            <dt class="text-xs font-bold uppercase tracking-wide text-primary">Sitio web</dt>
            <dd class="mt-1 break-all text-sm text-on-surface">
              <a href={datosTitular.web} class="font-semibold text-primary hover:underline">{datosTitular.web}</a>
            </dd>
          </div>
        </dl>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="objeto">
        <h2 id="objeto" class="text-xl font-bold text-on-secondary-fixed">2. Objeto del sitio web</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El sitio web tiene carácter informativo y facilita el acceso a contenidos relacionados con el C.B. Andratx, incluyendo, entre otros:</p>

        <ul class="mt-4 list-inside list-disc space-y-2 text-on-surface-variant">
          <li>Equipos y categorías del club.</li>
          <li>Horarios y ubicaciones de entrenamientos.</li>
          <li>Calendarios, partidos, resultados y clasificaciones.</li>
          <li>Eventos y actividades organizadas por el club.</li>
          <li>Entrevistas, vídeos y publicaciones en redes sociales.</li>
          <li>Información procedente de la FBIB y otras fuentes deportivas oficiales.</li>
          <li>Acceso al asistente virtual del club.</li>
        </ul>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="condiciones">
        <h2 id="condiciones" class="text-xl font-bold text-on-secondary-fixed">3. Condiciones de acceso y utilización</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El acceso al sitio web es, con carácter general, libre y gratuito. La persona usuaria se compromete a utilizar el sitio web, sus contenidos y sus funcionalidades de manera responsable, lícita y respetuosa.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">No está permitido utilizar este sitio web para realizar actividades ilícitas, causar daños a sus sistemas, intentar acceder a zonas restringidas, alterar sus contenidos o interferir en su funcionamiento.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El acceso a futuras áreas privadas o de gestión podrá requerir identificación y estará limitado exclusivamente a personas autorizadas por el club.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="informacion-deportiva">
        <h2 id="informacion-deportiva" class="text-xl font-bold text-on-secondary-fixed">4. Información deportiva y fuentes externas</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Parte de la información sobre partidos, resultados, clasificaciones, clubes, equipos e instalaciones procede de servicios y fuentes de la Federació de Bàsquet de les Illes Balears (FBIB).</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El C.B. Andratx procura mostrar la información de forma actualizada y correcta, pero no puede garantizar que los datos externos estén siempre disponibles, completos o libres de errores.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Las fechas, horarios, instalaciones, resultados y clasificaciones pueden sufrir modificaciones. Cuando se trate de información importante, debe comprobarse también en los canales oficiales del club o de la FBIB.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="responsabilidad">
        <h2 id="responsabilidad" class="text-xl font-bold text-on-secondary-fixed">5. Disponibilidad y responsabilidad</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El club realiza esfuerzos razonables para mantener el sitio web disponible y actualizado. Sin embargo, no puede garantizar el funcionamiento ininterrumpido de la web ni la ausencia de errores técnicos, interrupciones, retrasos o problemas derivados de servicios de terceros.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El C.B. Andratx no será responsable de decisiones tomadas exclusivamente a partir de información que haya quedado desactualizada, siempre dentro de los límites permitidos por la normativa aplicable.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Nada de lo establecido en este aviso legal pretende excluir o limitar responsabilidades que legalmente no puedan excluirse.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="propiedad-intelectual">
        <h2 id="propiedad-intelectual" class="text-xl font-bold text-on-secondary-fixed">6. Propiedad intelectual e industrial</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Los contenidos propios del sitio web, incluyendo su diseño, estructura, textos, elementos gráficos, código, logotipos y recursos visuales, están protegidos por la normativa aplicable sobre propiedad intelectual e industrial.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">No se permite su reproducción, modificación, distribución, comunicación pública o utilización con fines comerciales sin autorización previa del titular correspondiente, salvo en los casos permitidos por la ley.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Los nombres, logotipos, escudos, imágenes y contenidos pertenecientes a la FBIB, otros clubes, sponsors, plataformas o terceros son propiedad de sus respectivos titulares y se utilizan únicamente con fines informativos o con la autorización correspondiente.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="enlaces-externos">
        <h2 id="enlaces-externos" class="text-xl font-bold text-on-secondary-fixed">7. Enlaces y servicios de terceros</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El sitio web puede contener enlaces o integrar contenidos procedentes de servicios externos, como la FBIB, Google Maps, OpenStreetMap, CARTO, YouTube y las redes sociales del club.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El C.B. Andratx no controla de forma permanente los contenidos, la disponibilidad ni las políticas de privacidad de esos servicios. Al acceder a un enlace externo, la persona usuaria queda sujeta a las condiciones y políticas del proveedor correspondiente.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="menores">
        <h2 id="menores" class="text-xl font-bold text-on-secondary-fixed">8. Contenidos relacionados con menores</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El club desarrolla actividades deportivas en las que participan menores de edad. La publicación de imágenes, vídeos, nombres u otros contenidos identificativos debe realizarse respetando las autorizaciones aplicables y la normativa de protección de datos.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Si una persona considera que se ha publicado contenido relacionado con un menor sin autorización o de manera inadecuada, puede solicitar su revisión o retirada mediante el correo de contacto del club.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="privacidad">
        <h2 id="privacidad" class="text-xl font-bold text-on-secondary-fixed">9. Privacidad y almacenamiento local</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El tratamiento de datos personales realizado a través del sitio web se explica en la política de privacidad.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Determinadas preferencias, como los equipos favoritos, pueden guardarse en el almacenamiento local del navegador. Esta información permanece en el dispositivo de la persona usuaria salvo que se elimine o se configure posteriormente algún sistema de sincronización.</p>

        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/privacidad" class="inline-flex rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-on-primary transition-colors hover:bg-on-primary-container">Consultar la política de privacidad</a>
          <a href="/cookies" class="inline-flex rounded-lg border border-primary px-4 py-2.5 text-sm font-bold text-primary transition-colors hover:bg-primary-fixed">Consultar la política de cookies</a>
        </div>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="modificaciones">
        <h2 id="modificaciones" class="text-xl font-bold text-on-secondary-fixed">10. Modificación de las condiciones</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">El C.B. Andratx podrá modificar este aviso legal para adaptarlo a cambios en el sitio web, en sus servicios o en la normativa aplicable.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">La versión publicada en esta página será la vigente en cada momento. La fecha de la última actualización aparecerá al comienzo del documento.</p>
      </section>

      <section class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-6" aria-labelledby="legislacion">
        <h2 id="legislacion" class="text-xl font-bold text-on-secondary-fixed">11. Legislación aplicable</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Este aviso legal se rige por la legislación española. Cualquier controversia relacionada con el sitio web se resolverá conforme a las normas de competencia y jurisdicción que resulten legalmente aplicables.</p>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Entre otras normas, podrán resultar aplicables la Ley 34/2002, de servicios de la sociedad de la información y de comercio electrónico, la normativa de propiedad intelectual y la normativa española y europea de protección de datos.</p>
      </section>

      <section class="rounded-2xl border border-primary/30 bg-primary-fixed/50 p-6" aria-labelledby="contacto">
        <h2 id="contacto" class="text-xl font-bold text-on-secondary-fixed">12. Contacto</h2>

        <p class="mt-3 leading-relaxed text-on-surface-variant">Para comunicar errores, solicitar la revisión de contenidos o realizar cualquier consulta relacionada con este aviso legal, puede contactar con el club:</p>

        {datosTitular.email ? (
          <a href={`mailto:${datosTitular.email}`} class="mt-4 inline-flex rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-on-primary transition-colors hover:bg-on-primary-container">{datosTitular.email}</a>
        ) : (
          <p class="mt-4 rounded-lg border border-tertiary/30 bg-tertiary-fixed px-4 py-3 text-sm font-semibold text-on-tertiary-fixed">Correo electrónico pendiente de confirmación por la directiva.</p>
        )}
      </section>
    </div>
  </div> -->
</Layout>