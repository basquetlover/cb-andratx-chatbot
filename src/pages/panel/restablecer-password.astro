
---
import LayoutAccesoPanel from "@layouts/LayoutAccesoPanel.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<LayoutAccesoPanel
  title="Restablecer contraseña"
  description="Establece una nueva contraseña de acceso al panel."
>
  <section
    class="mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-outline-variant/70 bg-surface-container-lowest shadow-lg"
  >
    <header
      class="border-b border-outline-variant/60 bg-surface-container px-6 py-8 text-center"
    >
      <div
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary-fixed"
      >
        <span
          class="inline-block h-8 w-8 bg-primary mask-center mask-contain mask-no-repeat"
          style="mask-image:url('/iconos/panel/seguridad.svg');-webkit-mask-image:url('/iconos/panel/seguridad.svg');"
        ></span>
      </div>

      <h1 class="mt-5 text-2xl font-bold text-on-surface">
        Nueva contraseña
      </h1>

      <p class="mt-3 text-sm leading-6 text-on-surface-variant">
        Introduce y confirma tu nueva contraseña
        para recuperar el acceso al panel.
      </p>
    </header>

    <div class="p-6 sm:p-8">
      <div
        id="estado-restablecimiento"
        class="rounded-xl bg-surface-container px-4 py-4 text-center text-sm text-on-surface-variant"
        role="status"
        aria-live="polite"
      >
        Comprobando el enlace de recuperación...
      </div>

      <form
        id="formulario-restablecimiento"
        class="hidden space-y-5"
      >
        <label class="block">
          <span class="mb-2 block text-sm font-semibold text-on-surface">
            Nueva contraseña
          </span>

          <input
            id="nueva-password"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
            maxlength="128"
            placeholder="Mínimo 8 caracteres"
            class="h-12 w-full rounded-xl border border-outline-variant bg-surface-container-lowest px-4 text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
          />
        </label>

        <label class="block">
          <span class="mb-2 block text-sm font-semibold text-on-surface">
            Confirmar contraseña
          </span>

          <input
            id="confirmar-password"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
            maxlength="128"
            placeholder="Repite la contraseña"
            class="h-12 w-full rounded-xl border border-outline-variant bg-surface-container-lowest px-4 text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
          />
        </label>

        <label class="flex items-center gap-2 text-sm text-on-surface-variant">
          <input
            id="mostrar-passwords"
            type="checkbox"
            class="h-4 w-4 accent-primary"
          />
          Mostrar contraseñas
        </label>

        <p class="text-xs leading-5 text-on-surface-variant">
          Utiliza una contraseña de entre 8 y 128 caracteres.
          Es recomendable que sea única y difícil de adivinar.
        </p>

        <div
          id="error-restablecimiento"
          class="hidden rounded-xl border border-error/30 bg-error-container px-4 py-3 text-sm text-on-error-container"
          role="alert"
        ></div>

        <button
          id="boton-restablecimiento"
          type="submit"
          class="flex h-12 w-full items-center justify-center rounded-xl bg-primary px-5 font-bold text-on-primary transition hover:opacity-90 disabled:cursor-wait disabled:opacity-50"
        >
          Guardar nueva contraseña
        </button>
      </form>

      <a
        id="volver-inicio"
        href="/panel/iniciar-sesion"
        class="mt-6 hidden h-12 w-full items-center justify-center rounded-xl bg-primary px-5 text-sm font-bold text-on-primary"
      >
        Iniciar sesión
      </a>

      <div class="mt-6 text-center">
        <a
          href="/panel/recuperar-password"
          class="text-sm font-semibold text-primary hover:underline"
        >
          Solicitar otro enlace
        </a>
      </div>
    </div>
  </section>
</LayoutAccesoPanel>

<script>
  interface Respuesta {
    ok: boolean;
    data?: {
      expiresAt?: string;
      mensaje?: string;
    };
    error?: string;
  }

  const parametros = new URLSearchParams(
    window.location.search,
  );

  const token = parametros.get("token")?.trim() ?? "";

  const estado = document.querySelector<HTMLDivElement>(
    "#estado-restablecimiento",
  );

  const formulario = document.querySelector<HTMLFormElement>(
    "#formulario-restablecimiento",
  );

  const password = document.querySelector<HTMLInputElement>(
    "#nueva-password",
  );

  const confirmacion = document.querySelector<HTMLInputElement>(
    "#confirmar-password",
  );

  const mostrar = document.querySelector<HTMLInputElement>(
    "#mostrar-passwords",
  );

  const boton = document.querySelector<HTMLButtonElement>(
    "#boton-restablecimiento",
  );

  const error = document.querySelector<HTMLDivElement>(
    "#error-restablecimiento",
  );

  const volver = document.querySelector<HTMLAnchorElement>(
    "#volver-inicio",
  );

  function mostrarEstado(texto: string, correcto: boolean) {
    if (!estado) return;

    estado.textContent = texto;

    estado.className = correcto
      ? "rounded-xl border border-success/30 bg-success-container px-4 py-4 text-center text-sm leading-6 text-on-success-container"
      : "rounded-xl border border-error/30 bg-error-container px-4 py-4 text-center text-sm leading-6 text-on-error-container";
  }

  async function comprobarEnlace() {
    if (!token) {
      mostrarEstado(
        "El enlace de recuperación no es válido.",
        false,
      );
      return;
    }

    try {
      const respuesta = await fetch(
        `/api/acceso/restablecer-password?token=${encodeURIComponent(token)}`,
        {
          method: "GET",
          credentials: "same-origin",
          cache: "no-store",
        },
      );

      const contenido = (await respuesta.json()) as Respuesta;

      if (!respuesta.ok || !contenido.ok) {
        throw new Error(
          contenido.error || "El enlace no es válido.",
        );
      }

      estado?.classList.add("hidden");
      formulario?.classList.remove("hidden");
    } catch (errorCapturado) {
      mostrarEstado(
        errorCapturado instanceof Error
          ? errorCapturado.message
          : "No se ha podido comprobar el enlace.",
        false,
      );
    }
  }

  mostrar?.addEventListener("change", () => {
    const tipo = mostrar.checked ? "text" : "password";

    if (password) password.type = tipo;
    if (confirmacion) confirmacion.type = tipo;
  });

  formulario?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    if (
      !password ||
      !confirmacion ||
      !boton ||
      !formulario.reportValidity()
    ) {
      return;
    }

    error?.classList.add("hidden");

    if (password.value !== confirmacion.value) {
      if (error) {
        error.textContent = "Las contraseñas no coinciden.";
        error.classList.remove("hidden");
      }
      return;
    }

    boton.disabled = true;
    boton.textContent = "Guardando contraseña...";

    try {
      const respuesta = await fetch(
        "/api/acceso/restablecer-password",
        {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            token,
            password: password.value,
            confirmarPassword: confirmacion.value,
          }),
        },
      );

      const contenido = (await respuesta.json()) as Respuesta;

      if (!respuesta.ok || !contenido.ok) {
        throw new Error(
          contenido.error || "No se ha podido cambiar la contraseña.",
        );
      }

      password.value = "";
      confirmacion.value = "";

      formulario.classList.add("hidden");

      estado?.classList.remove("hidden");

      mostrarEstado(
        "Contraseña actualizada correctamente. Ya puedes acceder al panel con tus nuevas credenciales.",
        true,
      );

      volver?.classList.remove("hidden");
      volver?.classList.add("flex");

      window.history.replaceState(
        null,
        "",
        "/panel/restablecer-password",
      );
    } catch (errorCapturado) {
      if (error) {
        error.textContent =
          errorCapturado instanceof Error
            ? errorCapturado.message
            : "No se ha podido actualizar la contraseña.";

        error.classList.remove("hidden");
      }
    } finally {
      boton.disabled = false;
      boton.textContent = "Guardar nueva contraseña";
    }
  });

  void comprobarEnlace();
</script>
