
---
import LayoutAccesoPanel from "@layouts/LayoutAccesoPanel.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");
---

<LayoutAccesoPanel
  title="Recuperar contraseña"
  description="Recupera tu acceso al panel de gestión del C.B. Andratx."
>
  <section
    class="mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-outline-variant/70 bg-surface-container-lowest shadow-lg"
  >
    <header
      class="border-b border-outline-variant/60 bg-surface-container px-6 py-8 text-center"
    >
      <div
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary-fixed"
      >
        <span
          class="inline-block h-8 w-8 bg-primary mask-center mask-contain mask-no-repeat"
          style="mask-image:url('/iconos/panel/email.svg');-webkit-mask-image:url('/iconos/panel/email.svg');"
        ></span>
      </div>

      <h1 class="mt-5 text-2xl font-bold text-on-surface">
        Recuperar contraseña
      </h1>

      <p class="mt-3 text-sm leading-6 text-on-surface-variant">
        Introduce el correo electrónico de tu cuenta.
        Si está registrada, recibirás un enlace para
        establecer una nueva contraseña.
      </p>
    </header>

    <div class="p-6 sm:p-8">
      <form id="formulario-recuperacion" class="space-y-5">
        <label class="block">
          <span class="mb-2 block text-sm font-semibold text-on-surface">
            Correo electrónico
          </span>

          <input
            id="email-recuperacion"
            type="email"
            name="email"
            required
            autocomplete="email"
            maxlength="254"
            placeholder="nombre@ejemplo.com"
            class="h-12 w-full rounded-xl border border-outline-variant bg-surface-container-lowest px-4 text-on-surface outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
          />
        </label>

        <div
          id="mensaje-recuperacion"
          class="hidden rounded-xl px-4 py-3 text-sm leading-6"
          role="status"
          aria-live="polite"
        ></div>

        <button
          id="boton-recuperacion"
          type="submit"
          class="flex h-12 w-full items-center justify-center rounded-xl bg-primary px-5 font-bold text-on-primary transition hover:opacity-90 disabled:cursor-wait disabled:opacity-50"
        >
          Enviar enlace de recuperación
        </button>
      </form>

      <div class="mt-6 text-center">
        <a
          href="/panel/iniciar-sesion"
          class="text-sm font-semibold text-primary hover:underline"
        >
          Volver a iniciar sesión
        </a>
      </div>
    </div>
  </section>
</LayoutAccesoPanel>

<script>
  interface Respuesta {
    ok: boolean;
    data?: { mensaje: string };
    error?: string;
  }

  const formulario = document.querySelector<HTMLFormElement>(
    "#formulario-recuperacion",
  );

  const email = document.querySelector<HTMLInputElement>(
    "#email-recuperacion",
  );

  const boton = document.querySelector<HTMLButtonElement>(
    "#boton-recuperacion",
  );

  const mensaje = document.querySelector<HTMLDivElement>(
    "#mensaje-recuperacion",
  );

  function mostrarMensaje(texto: string, error: boolean) {
    if (!mensaje) return;

    mensaje.textContent = texto;

    mensaje.className = error
      ? "rounded-xl border border-error/30 bg-error-container px-4 py-3 text-sm leading-6 text-on-error-container"
      : "rounded-xl border border-success/30 bg-success-container px-4 py-3 text-sm leading-6 text-on-success-container";
  }

  formulario?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    if (!email || !boton || !formulario.reportValidity()) {
      return;
    }

    boton.disabled = true;
    boton.textContent = "Enviando solicitud...";

    mensaje?.classList.add("hidden");

    try {
      const respuesta = await fetch(
        "/api/acceso/recuperar-password",
        {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            email: email.value.trim(),
          }),
        },
      );

      const contenido = (await respuesta.json()) as Respuesta;

      if (!respuesta.ok || !contenido.ok) {
        throw new Error(
          contenido.error || "No se ha podido enviar la solicitud.",
        );
      }

      mostrarMensaje(
        contenido.data?.mensaje ||
          "Si tu cuenta está registrada, recibirás un correo.",
        false,
      );

      email.value = "";
    } catch (error) {
      mostrarMensaje(
        error instanceof Error
          ? error.message
          : "No se ha podido completar la solicitud.",
        true,
      );
    } finally {
      boton.disabled = false;
      boton.textContent = "Enviar enlace de recuperación";
    }
  });
</script>
