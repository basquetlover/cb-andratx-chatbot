
---
import LayoutPanel from "@layouts/LayoutPanel.astro";

import {
  obtenerUsuarioSesion,
  type UsuarioSesion,
} from "@servicios/backend/sesiones/obtenerUsuarioSesion";

import {
  comprobarPermisoUsuario,
} from "@servicios/seguridad/comprobarPermisoUsuario";

import {
  NOMBRE_COOKIE_SESION,
} from "@servicios/seguridad/cookieSesion";

import {
  PERMISOS_CODIGOS,
} from "@servicios/backend/codigos/seguridadCodigos";

import {
  esUuidCodigos,
} from "@servicios/backend/codigos/validarDatosCodigos";

import {
  obtenerEstadisticasCampanaCodigos,
} from "@servicios/backend/codigos/consultarCodigosPanel";

import {
  supabaseServidor,
} from "@servicios/supabase/servidor";

import type {
  EstadisticasCampanaCodigos,
  EstadoCampanaCodigos,
  EstadoVentasCampana,
  EstadoCanjesCampana,
} from "@tipos/CodigosPanel";

/*
 * CLUB BÀSQUET ANDRATX
 *
 * Fase 1 — Archivo 2/5
 *
 * Ficha individual de campaña.
 *
 * Ruta:
 * /panel/codigos/campanas/[id]
 *
 * Estructura:
 * - Resumen
 * - Artículos
 * - Escáner
 * - Impresión
 * - Configuración
 *
 * Modelo nuevo:
 * - QR compartido por artículo
 * - Cantidad inicial por artículo
 * - Canjeados
 * - No vendidos
 *
 * El modelo nuevo se implementará
 * en los siguientes archivos.
 *
 * Esta página no modifica datos.
 */

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "private, no-store, max-age=0",
);

Astro.response.headers.set(
  "X-Robots-Tag",
  "noindex, nofollow, noarchive",
);

// ================================================
// TIPOS
// ================================================

interface Campana {
  id: string;
  nombre: string;
  descripcion: string | null;

  estado: EstadoCampanaCodigos;
  estado_ventas: EstadoVentasCampana;
  estado_canjes: EstadoCanjesCampana;

  fecha_inicio: string | null;
  fecha_fin: string | null;

  created_at: string;
  updated_at: string | null;
}

// ================================================
// FUNCIONES
// ================================================

function formatearFecha(
  valor: string | null,
): string {
  if (!valor) {
    return "Sin definir";
  }

  const fecha = new Date(valor);

  if (Number.isNaN(fecha.getTime())) {
    return "Sin definir";
  }

  return new Intl.DateTimeFormat(
    "es-ES",
    {
      day: "2-digit",
      month: "short",
      year: "numeric",
    },
  ).format(fecha);
}

function formatearNumero(
  valor: number,
): string {
  return new Intl.NumberFormat(
    "es-ES",
  ).format(valor);
}

function nombreEstado(
  estado: EstadoCampanaCodigos,
): string {
  switch (estado) {
    case "borrador":
      return "Borrador";

    case "activa":
      return "Activa";

    case "finalizada":
      return "Finalizada";
  }
}

// ================================================
// IDENTIFICADOR
// ================================================

const campanaId =
  Astro.params.id?.trim() ?? "";

const identificadorValido =
  esUuidCodigos(campanaId);

const rutaCampana =
  `/panel/codigos/campanas/${
    encodeURIComponent(campanaId)
  }`;

// ================================================
// SESIÓN
// ================================================

const tokenSesion =
  Astro.cookies.get(
    NOMBRE_COOKIE_SESION,
  )?.value;

if (!tokenSesion) {
  return Astro.redirect(
    "/panel/iniciar-sesion",
    302,
  );
}

let sesion: UsuarioSesion | null = null;

try {
  sesion = await obtenerUsuarioSesion(
    tokenSesion,
  );
} catch (error) {
  console.error(
    "Error comprobando la sesión de campaña:",
    error,
  );

  return new Response(
    "No se ha podido comprobar la sesión.",
    {
      status: 500,
      headers: {
        "Cache-Control": "no-store",
      },
    },
  );
}

if (!sesion) {
  Astro.cookies.delete(
    NOMBRE_COOKIE_SESION,
    {
      path: "/",
    },
  );

  return Astro.redirect(
    "/panel/iniciar-sesion",
    302,
  );
}

// ================================================
// PERMISOS
// ================================================

let puedeVer = false;
let puedeVerPremios = false;

try {
  [
    puedeVer,
    puedeVerPremios,
  ] = await Promise.all([
    comprobarPermisoUsuario(
      sesion.acceso,
      PERMISOS_CODIGOS.ver,
    ),
    comprobarPermisoUsuario(
      sesion.acceso,
      PERMISOS_CODIGOS.premios,
    ),
  ]);
} catch (error) {
  console.error(
    "Error comprobando permisos de campaña:",
    error,
  );

  return new Response(
    "No se han podido comprobar los permisos.",
    {
      status: 500,
      headers: {
        "Cache-Control": "no-store",
      },
    },
  );
}

if (!puedeVer) {
  return Astro.redirect(
    "/panel/acceso-denegado",
    302,
  );
}

// ================================================
// CARGAR CAMPAÑA
// ================================================

let campana: Campana | null = null;

let errorCarga: string | null =
  null;

if (!identificadorValido) {
  Astro.response.status = 404;
} else {
  try {
    const {
      data,
      error,
    } = await supabaseServidor
      .from("codigos_campanas")
      .select(`
        id,
        nombre,
        descripcion,
        estado,
        estado_ventas,
        estado_canjes,
        fecha_inicio,
        fecha_fin,
        created_at,
        updated_at
      `)
      .eq("id", campanaId)
      .maybeSingle();

    if (error) {
      throw error;
    }

    if (!data) {
      Astro.response.status = 404;
    } else {
      campana = data as Campana;
    }
  } catch (error) {
    console.error(
      "Error consultando campaña:",
      error,
    );

    errorCarga =
      "No se ha podido cargar la campaña.";

    Astro.response.status = 500;
  }
}

// ================================================
// ESTADÍSTICAS EXISTENTES
// ================================================

let estadisticas:
  EstadisticasCampanaCodigos | null = null;

let errorEstadisticas:
  string | null = null;

/*
 * El servicio actual cuenta boletos
 * individuales del modelo anterior.
 *
 * Sus datos se presentan separados
 * de los futuros contadores por
 * artículo con QR compartido.
 *
 * Solo se consultan con permiso
 * codigos.premios.
 */

if (
  campana &&
  puedeVerPremios
) {
  try {
    estadisticas =
      await obtenerEstadisticasCampanaCodigos(
        sesion,
        campana.id,
      );
  } catch (error) {
    console.error(
      "Error consultando estadísticas:",
      error,
    );

    errorEstadisticas =
      "No se han podido consultar las estadísticas actuales.";
  }
}

// ================================================
// NAVEGACIÓN
// ================================================

const secciones = [
  {
    nombre: "Resumen",
    ruta: rutaCampana,
    disponible: true,
  },
  {
    nombre: "Artículos",
    ruta: `${rutaCampana}/articulos`,
    disponible: false,
  },
  {
    nombre: "Escáner",
    ruta: `${rutaCampana}/escaner`,
    disponible: false,
  },
  {
    nombre: "Impresión",
    ruta: `${rutaCampana}/impresion`,
    disponible: false,
  },
  {
    nombre: "Configuración",
    ruta: `${rutaCampana}/configuracion`,
    disponible: false,
  },
];

const titulo =
  campana?.nombre ??
  (
    errorCarga
      ? "Error al cargar la campaña"
      : "Campaña no encontrada"
  );
---

<LayoutPanel
  title={titulo}
  description="Gestión individual de la campaña de códigos y boletos."
  volverA="/panel/codigos"
  textoVolver="Volver a campañas"
  anchoCompleto
>
  {
    errorCarga ? (
      <section
        role="alert"
        class="mx-auto max-w-xl rounded-2xl border border-error/30 bg-error-container p-7 text-center text-on-error-container"
      >
        <h1 class="text-xl font-bold">
          Error al cargar la campaña
        </h1>

        <p class="mt-3 text-sm leading-6">
          {errorCarga}
        </p>

        <a
          href="/panel/codigos"
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-xl bg-error px-5 py-3 text-sm font-semibold text-on-error"
        >
          Volver a campañas
        </a>
      </section>
    ) : campana ? (
      <div class="space-y-6">

        <!-- ================================= -->
        <!-- INFORMACIÓN DE LA CAMPAÑA -->
        <!-- ================================= -->

        <section
          class="overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-sm"
        >
          <div class="flex h-1.5">
            <div class="w-2/3 bg-[#032A55]"></div>
            <div class="w-1/3 bg-[#F2C94C]"></div>
          </div>

          <div class="p-5 sm:p-7">
            <div
              class="flex flex-wrap items-start justify-between gap-4"
            >
              <div class="flex min-w-0 items-start gap-4">
                <span
                  class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary-container text-on-primary-container"
                >
                  <span
                    class="h-7 w-7 bg-current mask-center mask-contain mask-no-repeat"
                    style="mask-image: url('/iconos/panel/codigos.svg'); -webkit-mask-image: url('/iconos/panel/codigos.svg');"
                    aria-hidden="true"
                  ></span>
                </span>

                <div class="min-w-0">
                  <p
                    class="text-xs font-bold uppercase tracking-wider text-on-surface-variant"
                  >
                    Campaña
                  </p>

                  <h1
                    class="mt-1 text-xl font-bold tracking-tight text-on-surface sm:text-2xl"
                  >
                    {campana.nombre}
                  </h1>

                  <p
                    class="mt-3 max-w-2xl text-sm leading-6 text-on-surface-variant"
                  >
                    {campana.descripcion || "Esta campaña no tiene descripción."}
                  </p>
                </div>
              </div>

              <span
                class:list={[
                  "inline-flex rounded-full px-3 py-1.5 text-xs font-semibold",
                  campana.estado === "activa"
                    ? "bg-emerald-50 text-emerald-700"
                    : campana.estado === "borrador"
                      ? "bg-amber-50 text-amber-800"
                      : "bg-surface-container text-on-surface-variant",
                ]}
              >
                {nombreEstado(campana.estado)}
              </span>
            </div>

            <div
              class="mt-6 grid gap-3 border-t border-outline-variant/60 pt-5 sm:grid-cols-2 xl:grid-cols-4"
            >
              <div>
                <p class="text-xs text-on-surface-variant">
                  Inicio
                </p>
                <p class="mt-1 text-sm font-semibold text-on-surface">
                  {formatearFecha(campana.fecha_inicio)}
                </p>
              </div>

              <div>
                <p class="text-xs text-on-surface-variant">
                  Fin
                </p>
                <p class="mt-1 text-sm font-semibold text-on-surface">
                  {formatearFecha(campana.fecha_fin)}
                </p>
              </div>

              <div>
                <p class="text-xs text-on-surface-variant">
                  Ventas
                </p>
                <p class="mt-1 text-sm font-semibold capitalize text-on-surface">
                  {campana.estado_ventas}
                </p>
              </div>

              <div>
                <p class="text-xs text-on-surface-variant">
                  Canjes
                </p>
                <p class="mt-1 text-sm font-semibold capitalize text-on-surface">
                  {campana.estado_canjes}
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- ================================= -->
        <!-- MENÚ DE LA CAMPAÑA -->
        <!-- ================================= -->

        <nav
          aria-label="Secciones de la campaña"
          class="flex flex-wrap items-center gap-2 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-3"
        >
          {
            secciones.map((seccion) =>
              seccion.disponible ? (
                <a
                  href={seccion.ruta}
                  aria-current="page"
                  class="inline-flex min-h-10 items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary"
                >
                  {seccion.nombre}
                </a>
              ) : (
                <span
                  aria-disabled="true"
                  title="Sección pendiente de implementar"
                  class="inline-flex min-h-10 cursor-not-allowed items-center justify-center rounded-xl px-4 py-2.5 text-sm font-medium text-on-surface-variant opacity-60"
                >
                  {seccion.nombre}
                </span>
              )
            )
          }
        </nav>

        <!-- ================================= -->
        <!-- FUNCIONAMIENTO NUEVO -->
        <!-- ================================= -->

        <section class="space-y-4">
          <div>
            <h2 class="text-lg font-bold text-on-surface">
              Gestión de la campaña
            </h2>

            <p class="mt-1 text-sm text-on-surface-variant">
              La nueva gestión se organizará por artículos y cantidades.
            </p>
          </div>

          <div
            class="grid gap-4 md:grid-cols-2 xl:grid-cols-4"
          >
            <!-- ARTÍCULOS -->

            <article
              class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 shadow-sm"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-container text-on-primary-container"
              >
                <span
                  class="h-6 w-6 bg-current mask-center mask-contain mask-no-repeat"
                  style="mask-image: url('/iconos/panel/codigos.svg'); -webkit-mask-image: url('/iconos/panel/codigos.svg');"
                  aria-hidden="true"
                ></span>
              </span>

              <h3 class="mt-4 text-base font-bold text-on-surface">
                Artículos
              </h3>

              <p
                class="mt-2 text-sm leading-6 text-on-surface-variant"
              >
                Cada artículo tendrá su número de rasca,
                su QR compartido y una cantidad inicial.
              </p>

              <p class="mt-4 text-xs font-semibold text-primary">
                Pendiente de implementar
              </p>
            </article>

            <!-- CANJES -->

            <article
              class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 shadow-sm"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-container text-on-primary-container"
              >
                <span
                  class="h-6 w-6 bg-current mask-center mask-contain mask-no-repeat"
                  style="mask-image: url('/iconos/panel/qr.svg'); -webkit-mask-image: url('/iconos/panel/qr.svg');"
                  aria-hidden="true"
                ></span>
              </span>

              <h3 class="mt-4 text-base font-bold text-on-surface">
                Escáner
              </h3>

              <p
                class="mt-2 text-sm leading-6 text-on-surface-variant"
              >
                Permitirá registrar un boleto como
                canjeado o como no vendido.
              </p>

              <p class="mt-4 text-xs font-semibold text-primary">
                Pendiente de implementar
              </p>
            </article>

            <!-- IMPRESIÓN -->

            <article
              class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 shadow-sm"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-container text-on-primary-container"
              >
                <span
                  class="h-6 w-6 bg-current mask-center mask-contain mask-no-repeat"
                  style="mask-image: url('/iconos/panel/imagen.svg'); -webkit-mask-image: url('/iconos/panel/imagen.svg');"
                  aria-hidden="true"
                ></span>
              </span>

              <h3 class="mt-4 text-base font-bold text-on-surface">
                Impresión
              </h3>

              <p
                class="mt-2 text-sm leading-6 text-on-surface-variant"
              >
                Boletos con el número o icono bajo
                el rasca y el QR del artículo.
              </p>

              <p class="mt-4 text-xs font-semibold text-primary">
                Pendiente de implementar
              </p>
            </article>

            <!-- CONFIGURACIÓN -->

            <article
              class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 shadow-sm"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-container text-on-primary-container"
              >
                <span
                  class="h-6 w-6 bg-current mask-center mask-contain mask-no-repeat"
                  style="mask-image: url('/iconos/panel/configuracion.svg'); -webkit-mask-image: url('/iconos/panel/configuracion.svg');"
                  aria-hidden="true"
                ></span>
              </span>

              <h3 class="mt-4 text-base font-bold text-on-surface">
                Configuración
              </h3>

              <p
                class="mt-2 text-sm leading-6 text-on-surface-variant"
              >
                Datos, fechas, estado de la campaña
                y apertura o cierre de canjes.
              </p>

              <p class="mt-4 text-xs font-semibold text-primary">
                Pendiente de implementar
              </p>
            </article>
          </div>
        </section>

        <!-- ================================= -->
        <!-- CONTADORES DEL SISTEMA ACTUAL -->
        <!-- ================================= -->

        <section
          class="space-y-4 rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 shadow-sm sm:p-6"
        >
          <div>
            <h2 class="text-lg font-bold text-on-surface">
              Registros existentes
            </h2>

            <p class="mt-2 text-sm leading-6 text-on-surface-variant">
              Esta información procede del sistema
              anterior de boletos individuales.
              No representa todavía los contadores
              del nuevo sistema de QR compartidos.
            </p>
          </div>

          {
            !puedeVerPremios ? (
              <div
                class="rounded-xl bg-surface-container-low p-4 text-sm text-on-surface-variant"
              >
                Necesitas el permiso
                <strong> codigos.premios </strong>
                para consultar estos resultados.
              </div>
            ) : errorEstadisticas ? (
              <div
                role="alert"
                class="rounded-xl border border-error/30 bg-error-container p-4 text-sm text-on-error-container"
              >
                {errorEstadisticas}
              </div>
            ) : estadisticas ? (
              <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                <div
                  class="rounded-xl bg-surface-container-low p-4"
                >
                  <p class="text-xs text-on-surface-variant">
                    Boletos generados
                  </p>

                  <p class="mt-2 text-2xl font-bold text-on-surface">
                    {formatearNumero(estadisticas.totalGenerados)}
                  </p>
                </div>

                <div
                  class="rounded-xl bg-surface-container-low p-4"
                >
                  <p class="text-xs text-on-surface-variant">
                    Vendidos
                  </p>

                  <p class="mt-2 text-2xl font-bold text-on-surface">
                    {formatearNumero(estadisticas.vendidos)}
                  </p>
                </div>

                <div
                  class="rounded-xl bg-surface-container-low p-4"
                >
                  <p class="text-xs text-on-surface-variant">
                    No vendidos
                  </p>

                  <p class="mt-2 text-2xl font-bold text-on-surface">
                    {formatearNumero(estadisticas.noVendidos)}
                  </p>
                </div>

                <div
                  class="rounded-xl bg-surface-container-low p-4"
                >
                  <p class="text-xs text-on-surface-variant">
                    Premios entregados
                  </p>

                  <p class="mt-2 text-2xl font-bold text-on-surface">
                    {formatearNumero(estadisticas.premiosEntregados)}
                  </p>
                </div>
              </div>
            ) : (
              <p class="text-sm text-on-surface-variant">
                No hay estadísticas disponibles.
              </p>
            )
          }
        </section>

        <!-- ================================= -->
        <!-- INFORMACIÓN DEL NUEVO CONTROL -->
        <!-- ================================= -->

        <section
          class="rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-5 sm:p-6"
        >
          <h2 class="text-base font-bold text-on-surface">
            Control de cantidades
          </h2>

          <p
            class="mt-2 text-sm leading-6 text-on-surface-variant"
          >
            En el modelo simplificado, cada artículo
            tendrá una cantidad inicial definida.
            El escáner registrará canjes y boletos
            no vendidos como operaciones separadas.
          </p>

          <div
            class="mt-4 rounded-xl bg-surface-container-low p-4"
          >
            <p class="text-sm font-semibold text-on-surface">
              Pendientes de canjear
            </p>

            <p
              class="mt-2 text-sm text-on-surface-variant"
            >
              Cantidad inicial − No vendidos − Canjeados
            </p>

            <p
              class="mt-2 text-xs leading-5 text-on-surface-variant"
            >
              Este valor será definitivo cuando
              todos los boletos no vendidos
              estén registrados.
            </p>
          </div>
        </section>

      </div>
    ) : (
      <section
        class="mx-auto max-w-xl rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-8 text-center shadow-sm"
      >
        <p
          class="text-sm font-bold uppercase tracking-wide text-primary"
        >
          Error 404
        </p>

        <h1 class="mt-2 text-xl font-bold text-on-surface">
          Campaña no encontrada
        </h1>

        <p class="mt-3 text-sm text-on-surface-variant">
          La campaña solicitada no existe
          o su identificador no es válido.
        </p>

        <a
          href="/panel/codigos"
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-on-primary"
        >
          Volver a campañas
        </a>
      </section>
    )
  }
</LayoutPanel>
