---
import FormularioEquipo from "@components/panel/equipos/FormularioEquipo";
import PanelLayout from "@layouts/LayoutPanel.astro";

import { obtenerDatosFormularioEquipo } from "@servicios/backend/equipos/obtenerDatosFormularioEquipo";
import { obtenerUsuarioSesion } from "@servicios/backend/sesiones/obtenerUsuarioSesion";
import { comprobarPermisoUsuario } from "@servicios/seguridad/comprobarPermisoUsuario";
import { NOMBRE_COOKIE_SESION } from "@servicios/seguridad/cookieSesion";

import type { DatosFormularioEquipoPanel } from "@tipos/FormularioEquipoPanel";

export const prerender = false;

const tokenSesion =
    Astro.cookies.get(NOMBRE_COOKIE_SESION)?.value;

if (!tokenSesion) {
    return Astro.redirect(
        "/iniciar-sesion?redirect=/panel/equipos/nuevo",
    );
}

let sesion;

try {
    sesion = await obtenerUsuarioSesion(tokenSesion);
} catch (error) {
    console.error(
        "Error comprobando la sesión en /panel/equipos/nuevo:",
        error,
    );

    return Astro.redirect(
        "/panel/acceso-denegado?motivo=sesion",
    );
}

if (!sesion) {
    Astro.cookies.delete(NOMBRE_COOKIE_SESION, {
        path: "/",
    });

    return Astro.redirect(
        "/iniciar-sesion?redirect=/panel/equipos/nuevo",
    );
}

let puedeCrear = false;

try {
    puedeCrear = await comprobarPermisoUsuario(
        sesion.acceso,
        "equipos.crear",
    );
} catch (error) {
    console.error(
        "Error comprobando el permiso equipos.crear:",
        error,
    );

    return Astro.redirect(
        "/panel/acceso-denegado?motivo=permisos",
    );
}

if (!puedeCrear) {
    return Astro.redirect("/panel/acceso-denegado");
}

let datosFormulario: DatosFormularioEquipoPanel | null =
    null;

let errorCarga: string | null = null;

try {
    datosFormulario =
        await obtenerDatosFormularioEquipo();
} catch (error) {
    console.error(
        "Error cargando los datos del formulario de equipo:",
        error,
    );

    errorCarga =
        "No se han podido cargar los datos necesarios para crear el equipo.";
}
---

<PanelLayout
    title="Crear equipo"
    description="Configura la información, integraciones y patrocinadores del nuevo equipo."
    volverA="/panel/equipos"
    textoVolver="Volver a equipos"
>
    {
        datosFormulario ? (
            <FormularioEquipo
                datosFormulario={datosFormulario}
                client:load
            />
        ) : (
            <section class="rounded-2xl border border-error/30 bg-error-container p-6 text-on-error-container shadow-sm">
                <div class="flex items-start gap-4">
                    <span
                        class="inline-block h-7 w-7 shrink-0 bg-current mask-center mask-contain mask-no-repeat"
                        style="mask-image: url('/iconos/panel/error.svg'); -webkit-mask-image: url('/iconos/panel/error.svg');"
                        aria-hidden="true"
                    ></span>

                    <div class="min-w-0">
                        <h2 class="font-bold">
                            No se puede cargar el formulario
                        </h2>

                        <p class="mt-1 text-sm">
                            {
                                errorCarga ??
                                    "Ha ocurrido un problema al preparar el formulario."
                            }
                        </p>

                        <div class="mt-4 flex flex-wrap gap-3">
                            <a
                                href="/panel/equipos/nuevo"
                                class="inline-flex min-h-10 items-center justify-center rounded-xl border border-error px-4 py-2 text-sm font-bold transition-colors hover:bg-error hover:text-on-error"
                            >
                                Volver a intentarlo
                            </a>

                            <a
                                href="/panel/equipos"
                                class="inline-flex min-h-10 items-center justify-center rounded-xl px-4 py-2 text-sm font-bold text-on-error-container transition-colors hover:bg-error/10"
                            >
                                Volver a equipos
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        )
    }
</PanelLayout>