---
import Layout from "@layouts/Layout.astro";

export const prerender = false;
---

<Layout
  title="Acceso"
  description="Accede a tu carnet de socio o al panel de gestión del Club Bàsquet Andratx."
  menu
  menuMobile
>
  <main class="relative isolate min-h-[calc(100dvh-5rem)] overflow-hidden px-4 py-10 sm:py-14 lg:py-20">
    <div
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
      aria-hidden="true"
    >
      <div class="absolute -left-32 top-16 h-80 w-80 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute -right-32 bottom-10 h-96 w-96 rounded-full bg-tertiary/10 blur-3xl"></div>
    </div>

    <section class="mx-auto w-full max-w-5xl">
      <header class="mx-auto max-w-2xl text-center">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-container text-on-primary-container shadow-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-9 w-9 fill-current"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M480-120q-117 0-198.5-81.5T200-400v-280q0-33 23.5-56.5T280-760h120v-80h160v80h120q33 0 56.5 23.5T760-680v280q0 117-81.5 198.5T480-120m0-80q83 0 141.5-58.5T680-400v-280H280v280q0 83 58.5 141.5T480-200m-80-240q-33 0-56.5-23.5T320-520t23.5-56.5T400-600t56.5 23.5T480-520t-23.5 56.5T400-440m160 0q-33 0-56.5-23.5T480-520t23.5-56.5T560-600t56.5 23.5T640-520t-23.5 56.5T560-440M360-280v-40q0-50 35-85t85-35 85 35 35 85v40h-80v-40q0-17-11.5-28.5T480-360t-28.5 11.5T440-320v40z" />
          </svg>
        </span>

        <p class="mt-5 text-sm font-bold uppercase tracking-[0.18em] text-primary">
          Club Bàsquet Andratx
        </p>

        <h1 class="mt-2 text-3xl font-black text-on-tertiary-fixed sm:text-4xl md:text-5xl">
          ¿Dónde quieres acceder?
        </h1>

        <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-on-surface-variant sm:text-base">
          Elige el tipo de acceso que necesitas.
          Los socios pueden consultar su carnet
          digital y las personas autorizadas
          pueden entrar al panel de gestión.
        </p>
      </header>

      <div class="mt-9 grid gap-5 md:mt-12 md:grid-cols-2 md:gap-6">
        <a
          href="/socios/iniciar-sesion"
          class="group relative flex min-h-80 flex-col overflow-hidden rounded-3xl border border-primary/30 bg-primary-container p-6 text-on-primary-container shadow-[0_14px_40px_rgba(3,42,85,0.10)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_rgba(3,42,85,0.16)] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 sm:p-8"
        >
          <span
            class="pointer-events-none absolute -right-16 -top-16 h-52 w-52 rounded-full border-32px border-on-primary-container/5 transition-transform duration-500 group-hover:scale-110"
            aria-hidden="true"
          ></span>

          <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-primary text-on-primary shadow-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-9 w-9 fill-current"
              viewBox="0 -960 960 960"
              aria-hidden="true"
            >
              <path d="M160-120q-33 0-56.5-23.5T80-200v-560q0-33 23.5-56.5T160-840h640q33 0 56.5 23.5T880-760v560q0 33-23.5 56.5T800-120zm0-80h640v-560H160zm80-80h240v-40q0-33-33.5-56.5T360-400t-86.5 23.5T240-320zm320-40h160v-60H560zm0-120h160v-60H560zM360-440q25 0 42.5-17.5T420-500t-17.5-42.5T360-560t-42.5 17.5T300-500t17.5 42.5T360-440M160-200v-560z" />
            </svg>
          </div>

          <div class="relative mt-7">
            <p class="text-xs font-black uppercase tracking-[0.16em] opacity-70">
              Acceso para socios
            </p>

            <h2 class="mt-2 text-3xl font-black">
              Carnet de socio
            </h2>

            <p class="mt-3 max-w-md text-sm leading-6 opacity-80">
              Inicia sesión con el correo y la
              contraseña recibidos para consultar
              y mostrar tu carnet digital de la
              temporada.
            </p>
          </div>

          <span class="relative mt-auto inline-flex items-center gap-2 pt-8 text-sm font-black">
            Ver mi carnet

            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 fill-current transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 -960 960 960"
              aria-hidden="true"
            >
              <path d="m321-80-57-56 264-264-264-264 57-56 320 320z" />
            </svg>
          </span>
        </a>

        <a
          href="/panel"
          class="group relative flex min-h-80 flex-col overflow-hidden rounded-3xl border border-outline-variant/60 bg-surface-container-lowest p-6 text-on-surface shadow-[0_14px_40px_rgba(3,42,85,0.07)] transition duration-300 hover:-translate-y-1 hover:border-secondary/40 hover:shadow-[0_20px_50px_rgba(3,42,85,0.13)] focus:outline-none focus-visible:ring-4 focus-visible:ring-secondary/20 sm:p-8"
        >
          <span
            class="pointer-events-none absolute -bottom-20 -right-12 h-56 w-56 rounded-full bg-secondary/5 transition-transform duration-500 group-hover:scale-110"
            aria-hidden="true"
          ></span>

          <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary-container text-on-secondary-container shadow-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-9 w-9 fill-current"
              viewBox="0 -960 960 960"
              aria-hidden="true"
            >
              <path d="M120-80q-33 0-56.5-23.5T40-160v-640q0-33 23.5-56.5T120-880h360v80H120v640h360v80zm520-160-56-58 102-102H360v-80h326L584-582l56-58 200 200z" />
            </svg>
          </div>

          <div class="relative mt-7">
            <p class="text-xs font-black uppercase tracking-[0.16em] text-secondary">
              Acceso autorizado
            </p>

            <h2 class="mt-2 text-3xl font-black">
              Panel de gestión
            </h2>

            <p class="mt-3 max-w-md text-sm leading-6 text-on-surface-variant">
              Acceso reservado para entrenadores,
              directiva y otras personas
              autorizadas para administrar la
              información del club.
            </p>
          </div>

          <span class="relative mt-auto inline-flex items-center gap-2 pt-8 text-sm font-black text-secondary">
            Iniciar sesión

            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 fill-current transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 -960 960 960"
              aria-hidden="true"
            >
              <path d="m321-80-57-56 264-264-264-264 57-56 320 320z" />
            </svg>
          </span>
        </a>
      </div>

      <div class="mt-8 text-center">
        <a
          href="/"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-bold text-on-surface-variant transition-colors hover:bg-surface-container-low hover:text-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 fill-current"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80z" />
          </svg>

          Volver a la web
        </a>
      </div>
    </section>
  </main>
</Layout>