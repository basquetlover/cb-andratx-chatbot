---
import CalendarioTemporada from "@components/calendario/CalendarioTemporada";
import Layout from "@layouts/Layout.astro";

import type { EventoCalendario } from "@components/calendario/CalendarioTemporada";

function obtenerFechaMadrid(): Date {
	const partes = new Intl.DateTimeFormat("es-ES", {
		timeZone: "Europe/Madrid",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).formatToParts(new Date());

	const obtenerParte = (
		tipo: Intl.DateTimeFormatPartTypes,
	) =>
		Number(
			partes.find(
				(parte) => parte.type === tipo,
			)?.value ?? 0,
		);

	return new Date(
		Date.UTC(
			obtenerParte("year"),
			obtenerParte("month") - 1,
			obtenerParte("day"),
		),
	);
}

function sumarDias(
	fecha: Date,
	dias: number,
): Date {
	const resultado = new Date(fecha);

	resultado.setUTCDate(
		resultado.getUTCDate() + dias,
	);

	return resultado;
}

function convertirFechaIso(
	fecha: Date,
): string {
	const anio =
		fecha.getUTCFullYear();

	const mes = String(
		fecha.getUTCMonth() + 1,
	).padStart(2, "0");

	const dia = String(
		fecha.getUTCDate(),
	).padStart(2, "0");

	return `${anio}-${mes}-${dia}`;
}

const hoy = obtenerFechaMadrid();

const eventosEjemplo: EventoCalendario[] = [
	{
		id: "entrenamiento-infantil-1",
		titulo: "Entrenamiento Infantil Masculino",
		fecha: convertirFechaIso(hoy),
		tipo: "entreno",
		horaInicio: "18:00",
		horaFin: "19:30",
		ubicacion: "Palau d'Esports d'Andratx",
		descripcion:
			"Entrenamiento habitual del equipo Infantil Masculino.",
	},
	{
		id: "entrenamiento-cadete-1",
		titulo: "Entrenamiento Cadete Femenino",
		fecha: convertirFechaIso(
			sumarDias(hoy, 1),
		),
		tipo: "entreno",
		horaInicio: "19:30",
		horaFin: "21:00",
		ubicacion: "Palau d'Esports d'Andratx",
	},
	{
		id: "partido-casa-1",
		titulo: "C.B. Andratx – Club Visitante",
		fecha: convertirFechaIso(
			sumarDias(hoy, 3),
		),
		tipo: "partido-casa",
		horaInicio: "17:00",
		ubicacion: "Palau d'Esports d'Andratx",
		descripcion:
			"Partido correspondiente a la jornada de liga.",
	},
	{
		id: "partido-fuera-1",
		titulo: "Club Local – C.B. Andratx",
		fecha: convertirFechaIso(
			sumarDias(hoy, 5),
		),
		tipo: "partido-fuera",
		horaInicio: "18:30",
		ubicacion: "Pabellón del equipo local",
		descripcion:
			"Desplazamiento del equipo para disputar el partido como visitante.",
	},
	{
		id: "presentacion-club",
		titulo: "Presentación de los equipos",
		fecha: convertirFechaIso(
			sumarDias(hoy, 7),
		),
		tipo: "evento",
		horaInicio: "19:00",
		ubicacion: "Palau d'Esports d'Andratx",
		descripcion:
			"Presentación oficial de todos los equipos del club.",
	},
	{
		id: "tecnificacion",
		titulo: "Jornada de tecnificación",
		fecha: convertirFechaIso(
			sumarDias(hoy, 9),
		),
		fechaFin: convertirFechaIso(
			sumarDias(hoy, 11),
		),
		tipo: "evento",
		horaInicio: "10:00",
		horaFin: "13:00",
		ubicacion: "Palau d'Esports d'Andratx",
		descripcion:
			"Actividad de tecnificación organizada para varios equipos del club.",
	},
];
---

<Layout menu menuMobile>
