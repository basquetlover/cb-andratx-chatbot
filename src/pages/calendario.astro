---
import ContenedorCalendario from "@components/calendario/ContenedorCalendario";
import Layout from "@layouts/Layout.astro";
import Patrocinadores from "@sections/Patrocinadores.astro";

export const prerender = false;
---

<Layout
  title="Calendario"
  description="Consulta los partidos, entrenamientos y eventos del C.B. Andratx durante la temporada 2026/27."
  menu
  menuMobile
>
	<main class="mx-auto w-full max-w-7xl px-3 py-6 sm:px-4 md:py-10">
		<header class="mx-auto mb-6 max-w-3xl text-center md:mb-8">
			<span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-container text-on-primary-container shadow-sm">
				<span
					class="inline-block h-8 w-8 bg-current"
					style="mask-image: url('/iconos/calendario/evento.svg'); -webkit-mask-image: url('/iconos/calendario/evento.svg'); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain;"
					aria-hidden="true"
				></span>
			</span>

			<h1 class="mt-4 text-3xl font-bold text-on-tertiary-fixed sm:text-4xl md:text-5xl">
				Calendario
			</h1>

			<p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-on-surface-variant sm:text-base">
				Consulta los partidos, entrenamientos y eventos
				del C.B. Andratx en un único calendario.
			</p>
		</header>

		<ContenedorCalendario client:load />
	</main>
	<Patrocinadores />
</Layout>