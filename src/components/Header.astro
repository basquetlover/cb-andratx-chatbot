---
const NAV = [
    {
        nombre: "Inicio",
        enlace: "/",
        icono: "inicio",
        estado: "activo",
    },
    {
        nombre: "Asistente",
        enlace: "/chatbot",
        icono: "bot",
        estado: "activo",
    },
    {
        nombre: "Calendario",
        enlace: "/calendario",
        icono: "calendario",
        estado: "activo",
    },
    {
        nombre: "Equipos",
        enlace: "/equipos",
        icono: "equipos",
        estado: "activo",
    },
];

const rutaActual = Astro.url.pathname;

function esRutaActual(enlace: string): boolean {
    if (enlace === "/") {
        return rutaActual === "/";
    }

    return rutaActual === enlace || rutaActual.startsWith(`${enlace}/`);
}
---

<header class="sticky top-0 z-40 hidden w-full border-b border-outline-variant/60 bg-surface-container-low shadow-[0_4px_18px_rgba(3,42,85,0.06)] md:block">
    <div class="mx-auto flex h-20 w-full max-w-7xl items-center justify-between px-6 lg:px-10">
        <a href="/" class="group flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary" aria-label="Ir al inicio del C.B. Andratx">
            <img src="/favicon.png" alt="" class="h-13 w-13 object-contain transition-transform duration-300 group-hover:scale-105" />

            <span class="flex flex-col">
                <span class="text-3xl font-bold leading-tight text-on-secondary-fixed">C.B. Andratx</span>
                <!-- <span class="text-sm font-medium leading-tight text-secondary">Información del club</span> -->
            </span>
        </a>

        <nav aria-label="Navegación principal">
            <ul class="flex items-center gap-8">
                {
                    NAV.map((item) => {
                        const estaDisponible = item.estado === "activo";
                        const estaSeleccionado = estaDisponible && esRutaActual(item.enlace);

                        return (
                            <li class="relative">
                                {estaDisponible ? (
                                    <a
                                        href={item.enlace}
                                        class:list={[
                                            "group relative flex items-center gap-2 rounded-md py-3 font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary",
                                            estaSeleccionado ? "text-secondary" : "text-on-surface-variant hover:text-secondary",
                                        ]}
                                        aria-current={estaSeleccionado ? "page" : undefined}
                                    >
                                        <span
                                            class="inline-block h-5 w-5 shrink-0 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-hover:scale-110"
                                            style={`mask-image: url('/iconos/${item.icono}.svg'); -webkit-mask-image: url('/iconos/${item.icono}.svg');`}
                                            aria-hidden="true"
                                        />

                                        <span>{item.nombre}</span>

                                        <span
                                            class:list={[
                                                "absolute bottom-1 left-1/2 h-0.5 -translate-x-1/2 rounded-full bg-primary transition-[width] duration-300 ease-out",
                                                estaSeleccionado ? "w-full" : "w-0 group-hover:w-full group-focus-visible:w-full",
                                            ]}
                                            aria-hidden="true"
                                        />
                                    </a>
                                ) : (
                                    <span class="relative flex cursor-not-allowed items-center gap-2 py-3 font-semibold text-on-surface-variant opacity-45" aria-label={`${item.nombre}, próximamente`} aria-disabled="true">
                                        <span
                                            class="inline-block h-5 w-5 shrink-0 bg-current mask-center mask-contain mask-no-repeat"
                                            style={`mask-image: url('/iconos/${item.icono}.svg'); -webkit-mask-image: url('/iconos/${item.icono}.svg');`}
                                            aria-hidden="true"
                                        />

                                        <span>{item.nombre}</span>

                                        <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] font-semibold uppercase tracking-wide text-secondary">
                                            Próximamente
                                        </span>
                                    </span>
                                )}
                            </li>
                        );
                    })
                }
                <a href="/acceso" class="group relative flex items-center gap-2 rounded-md py-3 font-semibold transition-colors text-on-surface-variant hover:text-secondary duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary">
                    <span
                        class="inline-block h-6 w-6 shrink-0 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-hover:scale-110"
                        style={`mask-image: url('/iconos/cuenta.svg'); -webkit-mask-image: url('/iconos/cuenta.svg');`}
                        aria-hidden="true"
                    />
                </a>
            </ul>
            
        </nav>
    </div>
</header>