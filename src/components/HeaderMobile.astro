---
const NAV = [
    {
        nombre: "Inicio",
        enlace: "/",
        icono: "inicio",
        estado: "activo",
    },
    {
        nombre: "Asistente Virtual",
        enlace: "/chatbot",
        icono: "bot",
        estado: "activo",
    },
    {
        nombre: "Calendario",
        enlace: "/calendario",
        icono: "calendario",
        estado: "proximamente",
    },
    {
        nombre: "Equipos",
        enlace: "/equipos",
        icono: "equipos",
        estado: "activo",
    },
];

const primerosEnlaces = NAV.slice(0, 2);
const ultimosEnlaces = NAV.slice(2, 4);

const rutaActual = Astro.url.pathname;

function esRutaActual(enlace: string): boolean {
    if (enlace === "/") {
        return rutaActual === "/";
    }

    return rutaActual === enlace || rutaActual.startsWith(`${enlace}/`);
}
---

<header class="fixed inset-x-0 bottom-0 z-50 border-t border-outline-variant/50 bg-surface-container shadow-[0_-8px_24px_rgba(3,42,85,0.10)] md:hidden">
    <nav class="grid h-16 w-full grid-cols-5 items-center pb-[env(safe-area-inset-bottom)]" aria-label="Navegación principal">
        {
            primerosEnlaces.map((enlace) => {
                const estaDisponible = enlace.estado === "activo";
                const estaSeleccionado = estaDisponible && esRutaActual(enlace.enlace);

                return enlace.estado === "proximamente" ? (
                <span class="flex h-full flex-col items-center justify-center opacity-35" aria-label={`${enlace.nombre}, próximamente`} aria-disabled="true">
                    <span class="inline-block h-7 w-7 bg-on-secondary-fixed mask-center mask-contain mask-no-repeat" style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`} aria-hidden="true"></span>
                    <p class="text-[10px]">{enlace.nombre}</p>
                </span>
                ) : (
                <a href={enlace.enlace} class:list={["group flex h-full flex-col items-center justify-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary", estaSeleccionado ? "text-primary" : "text-on-secondary-fixed hover:text-primary"]} aria-label={enlace.nombre} aria-current={estaSeleccionado ? "page" : undefined}>
                    <span class="inline-block h-7 w-7 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-active:scale-90" style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`} aria-hidden="true"></span>
                    <p class="text-[10px]">{enlace.nombre}</p>
                </a>
                );
            })
        }

        <div class="relative flex h-full items-center justify-center">
            <a href="/panel" class="absolute -top-7 flex h-20 w-20 items-center justify-center rounded-full border border-outline-variant/50 bg-surface-container shadow-[0_-6px_18px_rgba(3,42,85,0.12)] transition-transform duration-200 active:scale-95" aria-label="Ir al inicio">
                <img src="/favicon.png" alt="" class="h-15 w-15 object-contain" />
            </a>
        </div>

        {
            ultimosEnlaces.map((enlace) => {
                const estaDisponible = enlace.estado === "activo";
                const estaSeleccionado = estaDisponible && esRutaActual(enlace.enlace);

                return enlace.estado === "proximamente" ? (
                <span class="flex h-full flex-col items-center justify-center opacity-35" aria-label={`${enlace.nombre}, próximamente`} aria-disabled="true">
                    <span class="inline-block h-7 w-7 bg-on-secondary-fixed mask-center mask-contain mask-no-repeat" style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`} aria-hidden="true"></span>
                    <p class="text-[10px]">{enlace.nombre}</p>
                </span>
                ) : (
                <a href={enlace.enlace} class:list={["group flex h-full flex-col items-center justify-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary", estaSeleccionado ? "text-primary" : "text-on-secondary-fixed hover:text-primary"]} aria-label={enlace.nombre} aria-current={estaSeleccionado ? "page" : undefined}>
                    <span class="inline-block h-7 w-7 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-active:scale-90" style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`} aria-hidden="true"></span>
                    <p class="text-[10px]">{enlace.nombre}</p>
                </a>
                );
            })
        }
    </nav>
</header>