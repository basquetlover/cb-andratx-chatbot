---
const NAV = [
    {
        nombre: "Inicio",
        enlace: "/",
        icono: "inicio",
        estado: "activo",
    },
    {
        nombre: "Asistente Virtual",
        enlace: "/chatbot",
        icono: "bot",
        estado: "activo",
    },
    {
        nombre: "Calendario",
        enlace: "/calendario",
        icono: "calendario",
        estado: "proximamente",
    },
    {
        nombre: "Equipos",
        enlace: "/equipos",
        icono: "equipos",
        estado: "proximamente",
    },
];

const primerosEnlaces = NAV.slice(0, 2);
const ultimosEnlaces = NAV.slice(2, 4);
---

<header class="fixed inset-x-0 bottom-0 z-50 border-t border-outline-variant/50 bg-surface-container shadow-[0_-8px_24px_rgba(3,42,85,0.10)] md:hidden">
    <nav class="grid h-16 w-full grid-cols-5 items-center pb-[env(safe-area-inset-bottom)]" aria-label="Navegación principal">
        {
            primerosEnlaces.map((enlace) => (
                enlace.estado === "proximamente" ? (
                    <span class="flex h-full items-center justify-center opacity-35" aria-label={`${enlace.nombre}, próximamente`} aria-disabled="true">
                        <span
                            class="inline-block h-7 w-7 bg-on-secondary-fixed mask-center mask-contain mask-no-repeat"
                            style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`}
                            aria-hidden="true"
                        />
                    </span>
                ) : (
                    <a href={enlace.enlace} class="group flex h-full items-center justify-center text-on-secondary-fixed transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" aria-label={enlace.nombre}>
                        <span
                            class="inline-block h-7 w-7 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-active:scale-90"
                            style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`}
                            aria-hidden="true"
                        />
                    </a>
                )
            ))
        }

        <div class="relative flex h-full items-center justify-center">
            <a href="/" class="absolute -top-7 flex h-20 w-20 items-center justify-center rounded-full border border-outline-variant/50 bg-surface-container shadow-[0_-6px_18px_rgba(3,42,85,0.12)] transition-transform duration-200 active:scale-95" aria-label="Ir al inicio">
                <img src="/favicon_40.png" alt="" class="h-15 w-15 object-contain" />
            </a>
        </div>

        {
            ultimosEnlaces.map((enlace) => (
                enlace.estado === "proximamente" ? (
                    <span class="flex h-full items-center justify-center opacity-35" aria-label={`${enlace.nombre}, próximamente`} aria-disabled="true">
                        <span
                            class="inline-block h-7 w-7 bg-on-secondary-fixed mask-center mask-contain mask-no-repeat"
                            style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`}
                            aria-hidden="true"
                        />
                    </span>
                ) : (
                    <a href={enlace.enlace} class="group flex h-full items-center justify-center text-on-secondary-fixed transition-colors hover:text-primary focus-visible:outline-offset-4 focus-visible:outline-primary" aria-label={enlace.nombre}>
                        <span
                            class="inline-block h-7 w-7 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-active:scale-90"
                            style={`mask-image: url('/iconos/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/${enlace.icono}.svg');`}
                            aria-hidden="true"
                        />
                    </a>
                )
            ))
        }
    </nav>
</header>