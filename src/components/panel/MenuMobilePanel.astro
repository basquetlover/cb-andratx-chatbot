---
import { navegacionPanelOrdenada, type EnlacePanel } from "../../configuracion/navegacionPanel";

const rutaActual = Astro.url.pathname;

const idsAccesoDirecto = ["resumen", "usuarios", "equipos"];

const accesosDirectos = idsAccesoDirecto
    .map((id) => navegacionPanelOrdenada.find((enlace) => enlace.id === id))
    .filter((enlace): enlace is EnlacePanel => enlace !== undefined);

const enlacesMenuCompleto = navegacionPanelOrdenada.filter((enlace) => !idsAccesoDirecto.includes(enlace.id));

function esRutaActual(enlace: EnlacePanel): boolean {
    if (enlace.enlace === "/panel") {
        return rutaActual === "/panel";
    }

    return rutaActual === enlace.enlace || rutaActual.startsWith(`${enlace.enlace}/`) || enlace.rutasRelacionadas?.some((ruta) => rutaActual === ruta || rutaActual.startsWith(`${ruta}/`)) === true;
}

const hayRutaSeleccionadaEnMas = enlacesMenuCompleto.some((enlace) => enlace.estado === "activo" && esRutaActual(enlace));
---

<details class="group fixed inset-x-0 bottom-0 z-50 md:hidden">
    <div class="fixed inset-0 -z-10 hidden bg-on-surface/40 backdrop-blur-[2px] group-open:block" aria-hidden="true"></div>

    <div class="absolute inset-x-3 bottom-[calc(5rem+env(safe-area-inset-bottom))] overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-[0_18px_60px_rgba(0,30,50,0.24)]">
        <div class="flex items-center justify-between border-b border-outline-variant/60 bg-surface-container-low px-4 py-3">
            <div>
                <p class="font-bold text-on-surface">Menú del panel</p>
                <p class="text-xs text-on-surface-variant">Todas las herramientas de gestión</p>
            </div>

            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-container text-on-surface-variant">
                <span class="inline-block h-4 w-4 bg-current mask-center mask-contain mask-no-repeat" style="mask-image: url('/iconos/panel/cerrar.svg'); -webkit-mask-image: url('/iconos/panel/cerrar.svg');" aria-hidden="true"></span>
            </span>
        </div>

        <nav class="max-h-[60dvh] overflow-y-auto p-3" aria-label="Más opciones del panel">
            <div class="grid grid-cols-2 gap-2">
                {enlacesMenuCompleto.map((enlace) => {
                    const estaDisponible = enlace.estado === "activo";
                    const estaSeleccionado = estaDisponible && esRutaActual(enlace);

                    if (!estaDisponible) {
                        return (
                            <div class="relative flex min-h-20 flex-col justify-center rounded-xl border border-outline-variant/50 bg-surface-container-low p-3 opacity-50" aria-label={`${enlace.nombre}, próximamente`} aria-disabled="true">
                                <span class="inline-block h-5 w-5 bg-on-surface-variant mask-center mask-contain mask-no-repeat" style={`mask-image: url('/iconos/panel/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/panel/${enlace.icono}.svg');`} aria-hidden="true"></span>
                                <span class="mt-2 text-sm font-semibold text-on-surface">{enlace.nombre}</span>
                                <span class="mt-0.5 text-[10px] font-bold uppercase tracking-wide text-on-surface-variant">Próximamente</span>
                            </div>
                        );
                    }

                    return (
                        <a href={enlace.enlace} class:list={["flex min-h-20 flex-col justify-center rounded-xl border p-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary", estaSeleccionado ? "border-primary bg-primary-fixed text-primary" : "border-outline-variant/60 bg-surface-container-lowest text-on-surface-variant hover:border-primary hover:bg-primary-fixed/40 hover:text-primary"]} aria-current={estaSeleccionado ? "page" : undefined}>
                            <span class="inline-block h-5 w-5 bg-current mask-center mask-contain mask-no-repeat" style={`mask-image: url('/iconos/panel/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/panel/${enlace.icono}.svg');`} aria-hidden="true"></span>
                            <span class="mt-2 text-sm font-semibold">{enlace.nombre}</span>
                            {enlace.descripcion && <span class="mt-0.5 line-clamp-1 text-[11px] opacity-75">{enlace.descripcion}</span>}
                        </a>
                    );
                })}
            </div>
        </nav>
    </div>

    <nav class="grid h-[calc(4.5rem+env(safe-area-inset-bottom))] grid-cols-4 border-t border-outline-variant/60 bg-surface-container-lowest px-2 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_rgba(0,30,50,0.10)]" aria-label="Navegación principal del panel">
        {accesosDirectos.map((enlace) => {
            const estaDisponible = enlace.estado === "activo";
            const estaSeleccionado = estaDisponible && esRutaActual(enlace);

            if (!estaDisponible) {
                return (
                    <span class="flex h-full flex-col items-center justify-center gap-1 text-on-surface-variant opacity-35" aria-label={`${enlace.nombre}, próximamente`} aria-disabled="true">
                        <span class="inline-block h-6 w-6 bg-current mask-center mask-contain mask-no-repeat" style={`mask-image: url('/iconos/panel/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/panel/${enlace.icono}.svg');`} aria-hidden="true"></span>
                        <span class="max-w-full truncate text-[10px] font-semibold">{enlace.nombreCorto ?? enlace.nombre}</span>
                    </span>
                );
            }

            return (
                <a href={enlace.enlace} class:list={["flex h-full flex-col items-center justify-center gap-1 transition-colors focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-primary", estaSeleccionado ? "text-primary" : "text-on-surface-variant hover:text-primary"]} aria-current={estaSeleccionado ? "page" : undefined}>
                    <span class:list={["inline-block bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 active:scale-90", estaSeleccionado ? "h-7 w-7" : "h-6 w-6"]} style={`mask-image: url('/iconos/panel/${enlace.icono}.svg'); -webkit-mask-image: url('/iconos/panel/${enlace.icono}.svg');`} aria-hidden="true"></span>
                    <span class="max-w-full truncate text-[10px] font-semibold">{enlace.nombreCorto ?? enlace.nombre}</span>
                </a>
            );
        })}

        <summary class:list={["flex h-full cursor-pointer list-none flex-col items-center justify-center gap-1 transition-colors marker:hidden focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-primary", hayRutaSeleccionadaEnMas ? "text-primary" : "text-on-surface-variant hover:text-primary"]} aria-label="Mostrar más opciones">
            <span class="inline-block h-6 w-6 bg-current mask-center mask-contain mask-no-repeat transition-transform duration-200 group-open:rotate-90" style="mask-image: url('/iconos/panel/mas.svg'); -webkit-mask-image: url('/iconos/panel/mas.svg');" aria-hidden="true"></span>
            <span class="text-[10px] font-semibold">Más</span>
        </summary>
    </nav>
</details>