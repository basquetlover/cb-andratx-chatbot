---
import PartidosPortada from "@components/inicio/PartidosPortada";

import {
  obtenerPartidosPortada,
} from "../servicios/backend/publicaciones/partidos/obtenerPartidosPortada.ts";

import type {
  PeriodoPartidosPortada,
} from "@tipos/PartidoPortada";

let datosPartidos:
  PeriodoPartidosPortada | null =
    null;

let errorPartidos:
  string | null =
    null;

try {
  datosPartidos =
    await obtenerPartidosPortada();
} catch (error) {
  console.error(
    "Error cargando los partidos de la semana:",
    error,
  );

  errorPartidos =
    "No se han podido cargar los partidos en este momento.";
}
---

<section
  class="py-10 sm:py-14"
  aria-labelledby="titulo-partidos-semana"
>
  <div class="mb-8 flex flex-col gap-3 text-center md:mb-10">
    <div
      class="mx-auto flex items-center gap-3"
      aria-hidden="true"
    >
      <span class="h-px w-12 bg-outline-variant sm:w-24"></span>

      <span class="h-5 w-5 rotate-45 fill-primary">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 -960 960 960"
        >
          <path d="M162-520h114q-6-38-23-71t-43-59q-18 29-30.5 61.5T162-520m522 0h114q-5-36-17.5-68.5T750-650q-26 26-43 59t-23 71M210-310q26-26 43-59t23-71H162q5 36 17.5 68.5T210-310m540 0q18-29 30.5-61.5T798-440H684q6 38 23 71t43 59M358-520h82v-278q-53 8-98.5 29.5T260-712q39 38 64.5 86.5T358-520m162 0h82q8-57 33.5-105.5T700-712q-36-35-81.5-56.5T520-798zm-80 358v-278h-82q-8 57-33.5 105.5T260-248q36 35 81.5 56.5T440-162m80 0q53-8 98.5-29.5T700-248q-39-38-64.5-86.5T602-440h-82zm-40 82q-83 0-156-31.5T197-197t-85.5-127T80-480t31.5-156T197-763t127-85.5T480-880t156 31.5T763-763t85.5 127T880-480t-31.5 156T763-197t-127 85.5T480-80" />
        </svg>
      </span>

      <span class="h-px w-12 bg-outline-variant sm:w-24"></span>
    </div>

    <p class="text-sm font-bold uppercase tracking-[0.22em] text-secondary">
      Agenda del club
    </p>

    <h2
      id="titulo-partidos-semana"
      class="text-3xl font-bold text-on-secondary-fixed sm:text-4xl lg:text-5xl"
    >
      Partidos de la semana
    </h2>

    <p class="mx-auto max-w-155 text-on-surface-variant">
      Consulta los resultados y la programación de los equipos del Club Bàsquet Andratx.
    </p>
  </div>

  {
    datosPartidos ? (
      <PartidosPortada
        client:visible
        datos={datosPartidos}
        mostrarCabecera={false}
        tituloId="titulo-partidos-semana"
        />
    ) : (
      <div
        class="mx-auto max-w-xl py-10 text-center"
        role="status"
        aria-live="polite"
      >
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-surface-container-low text-on-surface-variant">
          <svg
            viewBox="0 0 24 24"
            width="26"
            height="26"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 2v3"></path>
            <path d="M17 2v3"></path>
            <path d="M3 9h18"></path>

            <rect
              x="3"
              y="4"
              width="18"
              height="17"
              rx="3"
            ></rect>
          </svg>
        </span>

        <p class="mt-4 font-bold text-on-surface">
          No se han podido cargar los partidos
        </p>

        <p class="mt-1 text-sm text-on-surface-variant">
          {errorPartidos}
        </p>

        <a
          href="/calendario"
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-xl border border-secondary px-5 py-2 text-sm font-bold text-secondary transition-colors hover:bg-secondary hover:text-on-secondary"
        >
          Consultar el calendario
        </a>
      </div>
    )
  }
</section>