---
const PLAYLIST_ID = "PLHGlkZ9buMtFPiauhzKiy-WfnNwxp36kh";
const PLAYLIST_URL = `https://www.youtube.com/playlist?list=${PLAYLIST_ID}`;
const FEED_URL = `https://www.youtube.com/feeds/videos.xml?playlist_id=${PLAYLIST_ID}`;
const MAXIMO_ENTREVISTAS = 8;

interface EntrevistaYoutube {
    videoId: string;
    titulo: string;
    fechaPublicacion: Date;
    miniatura: string;
    miniaturaAltaResolucion: string;
    miniaturaAlternativa: string;
    url: string;
}

function extraerEtiqueta(contenido: string, etiqueta: string): string | null {
    const expresion = new RegExp(`<${etiqueta}(?:\\s[^>]*)?>([\\s\\S]*?)<\\/${etiqueta}>`, "i");
    const coincidencia = contenido.match(expresion);

    return coincidencia?.[1]?.trim() ?? null;
}

function decodificarXml(texto: string): string {
    return texto
        .replace(/^<!\[CDATA\[|\]\]>$/g, "")
        .replace(/&#x([0-9a-f]+);/gi, (_, codigo: string) => String.fromCodePoint(Number.parseInt(codigo, 16)))
        .replace(/&#([0-9]+);/g, (_, codigo: string) => String.fromCodePoint(Number.parseInt(codigo, 10)))
        .replace(/&amp;/g, "&")
        .replace(/&quot;/g, '"')
        .replace(/&apos;/g, "'")
        .replace(/&lt;/g, "<")
        .replace(/&gt;/g, ">");
}

function convertirFeed(contenido: string): EntrevistaYoutube[] {
    const entradas = Array.from(contenido.matchAll(/<entry\b[^>]*>([\s\S]*?)<\/entry>/gi));

    return entradas
        .map((coincidencia): EntrevistaYoutube | null => {
            const entrada = coincidencia[1];
            const videoId = extraerEtiqueta(entrada, "yt:videoId");
            const tituloXml = extraerEtiqueta(entrada, "media:title") ?? extraerEtiqueta(entrada, "title");
            const fechaXml = extraerEtiqueta(entrada, "published");

            if (!videoId || !tituloXml || !fechaXml) {
                return null;
            }

            const fechaPublicacion = new Date(fechaXml);

            if (Number.isNaN(fechaPublicacion.getTime())) {
                return null;
            }

            return {
                videoId,
                titulo: decodificarXml(tituloXml),
                fechaPublicacion,
                miniatura: `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`,
                miniaturaAltaResolucion: `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`,
                miniaturaAlternativa: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
                url: `https://www.youtube.com/watch?v=${videoId}`,
            };
        })
        .filter((entrevista): entrevista is EntrevistaYoutube => entrevista !== null)
        .sort((primera, segunda) => segunda.fechaPublicacion.getTime() - primera.fechaPublicacion.getTime())
        .slice(0, MAXIMO_ENTREVISTAS);
}

const formatoFecha = new Intl.DateTimeFormat("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Europe/Madrid",
});

const formatoRelativo = new Intl.RelativeTimeFormat("es-ES", {
    numeric: "auto",
});

function formatearFechaRelativa(fecha: Date): string {
    const diferenciaMilisegundos = fecha.getTime() - Date.now();
    const diferenciaHoras = Math.round(diferenciaMilisegundos / (1000 * 60 * 60));
    const diferenciaDias = Math.round(diferenciaHoras / 24);

    if (Math.abs(diferenciaHoras) < 24) {
        return formatoRelativo.format(diferenciaHoras, "hour");
    }

    if (Math.abs(diferenciaDias) < 30) {
        return formatoRelativo.format(diferenciaDias, "day");
    }

    const diferenciaMeses = Math.round(diferenciaDias / 30);

    if (Math.abs(diferenciaMeses) < 12) {
        return formatoRelativo.format(diferenciaMeses, "month");
    }

    return formatoFecha.format(fecha);
}

let entrevistas: EntrevistaYoutube[] = [];
let errorCarga: string | null = null;

try {
    const respuesta = await fetch(FEED_URL, {
        headers: {
            Accept: "application/atom+xml, application/xml, text/xml",
        },
        signal: AbortSignal.timeout(8000),
    });

    if (!respuesta.ok) {
        throw new Error(`YouTube ha respondido con el estado ${respuesta.status}`);
    }

    const contenido = await respuesta.text();

    entrevistas = convertirFeed(contenido);
} catch (error) {
    console.error("Error al obtener las entrevistas de YouTube:", error);
    errorCarga = "No hemos podido cargar las entrevistas en este momento.";
}

const entrevistaDestacada = entrevistas[0] ?? null;
const entrevistasSecundarias = entrevistas.slice(1);
---

<section id="entrevistas" class="relative w-full px-4 py-16 sm:px-6 lg:py-24" aria-labelledby="titulo-entrevistas">
    <div class="mx-auto flex w-full max-w-7xl flex-col">
        <div class="mb-8 flex flex-col gap-3 text-center md:mb-10">
            <div class="mx-auto flex items-center gap-3" aria-hidden="true">
                <span class="h-px w-12 bg-outline-variant sm:w-24"></span>
                <span class="h-5 w-5 rotate-45 fill-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 -960 960 960">
                        <path d="M162-520h114q-6-38-23-71t-43-59q-18 29-30.5 61.5T162-520m522 0h114q-5-36-17.5-68.5T750-650q-26 26-43 59t-23 71M210-310q26-26 43-59t23-71H162q5 36 17.5 68.5T210-310m540 0q18-29 30.5-61.5T798-440H684q6 38 23 71t43 59M358-520h82v-278q-53 8-98.5 29.5T260-712q39 38 64.5 86.5T358-520m162 0h82q8-57 33.5-105.5T700-712q-36-35-81.5-56.5T520-798zm-80 358v-278h-82q-8 57-33.5 105.5T260-248q36 35 81.5 56.5T440-162m80 0q53-8 98.5-29.5T700-248q-39-38-64.5-86.5T602-440h-82zm-40 82q-83 0-156-31.5T197-197t-85.5-127T80-480t31.5-156T197-763t127-85.5T480-880t156 31.5T763-763t85.5 127T880-480t-31.5 156T763-197t-127 85.5T480-80"/>
                    </svg>
                </span>
                <span class="h-px w-12 bg-outline-variant sm:w-24"></span>
            </div>

            <p class="text-sm font-bold uppercase tracking-[0.22em] text-secondary">Dentro de la pista</p>

            <h2 id="titulo-entrevistas" class="text-3xl font-bold text-on-secondary-fixed sm:text-4xl lg:text-5xl">
                Entrevistas C.B. Andratx
            </h2>

            <p class="mx-auto max-w-155 text-on-surface-variant">
                Conoce a los jugadores, entrenadores y personas que forman parte de nuestro club.
            </p>
        </div>

        <div class="w-full overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-[0_20px_50px_-24px_rgba(3,42,85,0.28)]">
            <header class="flex items-center justify-between gap-4 border-b border-outline-variant/60 bg-surface-container px-4 py-3 sm:px-6">
                <div class="flex min-w-0 items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#ff0000]/10 text-[#ff0000]" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
                            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"></path>
                        </svg>
                    </span>

                    <div class="flex min-w-0 flex-col">
                        <span class="truncate font-bold text-on-secondary-fixed">Entrevistas del club</span>

                        <a href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer" class="w-fit text-xs font-semibold text-secondary transition-colors hover:text-on-secondary-container focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary">
                            Ver playlist en YouTube
