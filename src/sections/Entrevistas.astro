                    </div>
                </div>

                {!errorCarga && (
                    <span class="hidden text-sm font-semibold text-on-surface-variant sm:inline">
                        {entrevistas.length} entrevista{entrevistas.length === 1 ? "" : "s"}
                    </span>
                )}
            </header>

            {errorCarga ? (
                <div class="flex min-h-72 flex-col items-center justify-center px-6 py-12 text-center">
                    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-error-container text-error" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 8v5M12 17h.01M10.3 4.9 2.7 18a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 4.9a2 2 0 0 0-3.4 0Z" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </span>

                    <p class="mt-4 font-bold text-on-secondary-fixed">No se han podido cargar las entrevistas</p>
                    <p class="mt-1 max-w-110 text-sm text-on-surface-variant">{errorCarga}</p>

                    <a href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer" class="mt-5 rounded-lg bg-secondary px-5 py-2.5 text-sm font-semibold text-on-secondary transition-colors hover:bg-on-secondary-container">
                        Ver entrevistas en YouTube
                    </a>
                </div>
            ) : entrevistas.length === 0 ? (
                <div class="flex min-h-72 flex-col items-center justify-center px-6 py-12 text-center">
                    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-fixed text-primary" aria-hidden="true">
                        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m9 8 7 4-7 4V8Z" stroke-linejoin="round"></path>
                            <rect x="3" y="5" width="18" height="14" rx="3"></rect>
                        </svg>
                    </span>

                    <p class="mt-4 font-bold text-on-secondary-fixed">Todavía no hay entrevistas disponibles</p>
                    <p class="mt-1 text-sm text-on-surface-variant">Cuando publiquemos una nueva entrevista aparecerá aquí.</p>
                </div>
            ) : (
                <div class:list={["grid gap-px bg-outline-variant/50", entrevistasSecundarias.length > 0 ? "lg:grid-cols-[minmax(0,1.15fr)_minmax(340px,0.85fr)]" : "grid-cols-1"]}>
                    {entrevistaDestacada && (
                        <button type="button" data-reproducir-entrevista data-video-id={entrevistaDestacada.videoId} data-video-title={entrevistaDestacada.titulo} class="group relative isolate flex aspect-video w-full cursor-pointer overflow-hidden bg-on-secondary-fixed text-left focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-primary lg:h-[31rem] lg:aspect-auto" aria-label={`Reproducir entrevista destacada: ${entrevistaDestacada.titulo}`}>
                            <img src={entrevistaDestacada.miniatura} alt="" loading="eager" decoding="async" class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover brightness-75 transition duration-700 group-hover:scale-110 group-hover:brightness-90" />

                            <img src={entrevistaDestacada.miniaturaAltaResolucion} alt="" loading="eager" decoding="async" fetchpriority="high" data-imagen-destacada data-fallback={entrevistaDestacada.miniaturaAlternativa} class="imagen-destacada absolute inset-0 -z-20 h-full w-full scale-105 object-cover opacity-0 brightness-75 transition duration-700 group-hover:scale-110 group-hover:brightness-90" />

                            <span class="absolute inset-0 -z-10 bg-linear-to-t from-on-secondary-fixed via-on-secondary-fixed/35 to-transparent" aria-hidden="true"></span>

                            <span class="absolute right-4 top-4 rounded-full border border-primary/60 bg-on-secondary-fixed/75 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary backdrop-blur-sm">
                                Última entrevista
                            </span>

                            <span class="absolute inset-0 flex items-center justify-center z-30" aria-hidden="true">
                                <span class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-white/70 bg-on-secondary-fixed/65 text-white shadow-lg backdrop-blur-sm transition duration-300 group-hover:scale-110 group-hover:border-primary group-hover:bg-primary group-hover:text-on-primary">
                                    <svg viewBox="0 0 24 24" class="h-7 w-7 translate-x-0.5" fill="currentColor">
                                        <path d="M8 5v14l11-7L8 5Z"></path>
                                    </svg>
                                </span>
                            </span>

                            <div class="relative mt-auto flex w-full flex-col gap-2 p-5 text-white sm:p-7">
                                <time datetime={entrevistaDestacada.fechaPublicacion.toISOString()} title={formatoFecha.format(entrevistaDestacada.fechaPublicacion)} class="text-xs font-bold uppercase tracking-[0.2em] text-primary">
                                    {formatearFechaRelativa(entrevistaDestacada.fechaPublicacion)}
                                </time>

                                <h3 class="max-w-190 text-2xl font-bold leading-tight drop-shadow-md sm:text-3xl lg:text-4xl">
                                    {entrevistaDestacada.titulo}
                                </h3>

                                <span class="mt-1 inline-flex items-center gap-2 text-sm font-bold text-white/80 transition-colors group-hover:text-primary">
                                    Ver entrevista

                                    <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </span>
                            </div>
                        </button>
                    )}

                    {entrevistasSecundarias.length > 0 && (
                        <ul class="lista-entrevistas grid max-h-136 gap-px overflow-y-auto bg-outline-variant/50 sm:grid-cols-2 lg:max-h-124 lg:grid-cols-1">
                            {entrevistasSecundarias.map((entrevista) => (
                                <li class="bg-surface-container-lowest">
                                    <button type="button" data-reproducir-entrevista data-video-id={entrevista.videoId} data-video-title={entrevista.titulo} class="group grid h-full w-full cursor-pointer grid-cols-[6rem_1fr_auto] items-center gap-3 bg-surface-container-lowest p-3 text-left transition-colors hover:bg-surface-container-low focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-secondary sm:grid-cols-[7rem_1fr_auto] sm:p-4" aria-label={`Reproducir entrevista: ${entrevista.titulo}`}>
                                        <span class="relative block aspect-video overflow-hidden rounded-lg bg-surface-container">
                                            <img src={entrevista.miniatura} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />

                                            <span class="absolute inset-0 flex items-center justify-center bg-on-secondary-fixed/25 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">
                                                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-on-primary">
                                                    <svg viewBox="0 0 24 24" class="h-4 w-4 translate-x-px" fill="currentColor">
                                                        <path d="M8 5v14l11-7L8 5Z"></path>
                                                    </svg>
                                                </span>
                                            </span>
                                        </span>

                                        <span class="flex min-w-0 flex-col gap-1">
                                            <span class="line-clamp-2 text-sm font-bold leading-snug text-on-secondary-fixed transition-colors group-hover:text-secondary sm:text-base">
                                                {entrevista.titulo}
                                            </span>

                                            <time datetime={entrevista.fechaPublicacion.toISOString()} title={formatoFecha.format(entrevista.fechaPublicacion)} class="text-xs text-on-surface-variant">
                                                {formatearFechaRelativa(entrevista.fechaPublicacion)}
                                            </time>
                                        </span>

                                        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-outline transition-all duration-300 group-hover:translate-x-1 group-hover:text-secondary" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                    </button>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
            )}
        </div>
    </div>
</section>

<dialog id="reproductor-entrevista" class="m-auto w-[calc(100%-2rem)] max-w-[960px] overflow-hidden rounded-2xl border border-outline-variant bg-on-secondary-fixed p-0 shadow-2xl backdrop:bg-on-secondary-fixed/80 backdrop:backdrop-blur-sm">
    <div class="flex items-center justify-between gap-4 border-b border-white/15 px-4 py-3 text-white sm:px-5">
        <p id="titulo-reproductor-entrevista" class="truncate font-semibold">Entrevista C.B. Andratx</p>

        <button type="button" data-cerrar-reproductor class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-white/70 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="Cerrar reproductor">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m7 7 10 10M17 7 7 17" stroke-linecap="round"></path>
            </svg>
        </button>
    </div>

    <div class="aspect-video w-full bg-black">
        <iframe id="iframe-entrevista" class="h-full w-full" title="Reproductor de entrevista" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
</dialog>

<script>
    const imagenDestacada = document.querySelector<HTMLImageElement>("[data-imagen-destacada]");

    if (imagenDestacada) {
        const mostrarImagen = () => {
            imagenDestacada.classList.add("cargada");
        };

        const cargarAlternativa = () => {
            const imagenAlternativa = imagenDestacada.dataset.fallback;

            if (imagenAlternativa && imagenDestacada.src !== imagenAlternativa) {
                imagenDestacada.src = imagenAlternativa;
                return;
            }

            mostrarImagen();
        };

        imagenDestacada.addEventListener("load", () => {
            const esMarcadorDeYouTube = imagenDestacada.naturalWidth === 120 && imagenDestacada.naturalHeight === 90;

            if (esMarcadorDeYouTube) {
                cargarAlternativa();
                return;
            }

            mostrarImagen();
        });

        imagenDestacada.addEventListener("error", cargarAlternativa);

        if (imagenDestacada.complete && imagenDestacada.naturalWidth > 0) {
            mostrarImagen();
        }
    }

    const dialogo = document.querySelector<HTMLDialogElement>("#reproductor-entrevista");
    const iframe = document.querySelector<HTMLIFrameElement>("#iframe-entrevista");
    const tituloReproductor = document.querySelector<HTMLElement>("#titulo-reproductor-entrevista");
    const botonesReproduccion = document.querySelectorAll<HTMLElement>("[data-reproducir-entrevista]");
    const botonCerrar = document.querySelector<HTMLElement>("[data-cerrar-reproductor]");

    const cerrarReproductor = () => {
        if (!dialogo || !iframe) {
            return;
        }

        iframe.src = "";
        dialogo.close();
    };

    botonesReproduccion.forEach((boton) => {
        boton.addEventListener("click", () => {
            if (!dialogo || !iframe) {
                return;
            }

            const videoId = boton.dataset.videoId;
            const titulo = boton.dataset.videoTitle;

            if (!videoId) {
                return;
            }

            iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;

            if (tituloReproductor && titulo) {
                tituloReproductor.textContent = titulo;
            }

            dialogo.showModal();
        });
    });

    botonCerrar?.addEventListener("click", cerrarReproductor);

    dialogo?.addEventListener("click", (evento) => {
        if (evento.target === dialogo) {
            cerrarReproductor();
        }
    });

    dialogo?.addEventListener("close", () => {
        if (iframe) {
            iframe.src = "";
        }
    });
</script>

<style>
    .imagen-destacada.cargada {
        opacity: 1;
    }

    .lista-entrevistas {
        scrollbar-width: thin;
        scrollbar-color: var(--color-secondary) transparent;
        scrollbar-gutter: stable;
    }

    .lista-entrevistas::-webkit-scrollbar {
        width: 8px;
    }

    .lista-entrevistas::-webkit-scrollbar-track {
        background: transparent;
    }

    .lista-entrevistas::-webkit-scrollbar-thumb {
        border: 2px solid transparent;
        border-radius: 999px;
        background-color: var(--color-secondary);
        background-clip: content-box;
    }

    #reproductor-entrevista::backdrop {
        background: rgb(0 27 60 / 80%);
        backdrop-filter: blur(4px);
    }
</style>